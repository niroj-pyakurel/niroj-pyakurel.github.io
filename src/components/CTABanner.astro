---
import { site } from '../data/site.js';

const { id = 'cta-title', contained = true, className = '' } = Astro.props;
const inquiryHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---

<section
  class:list={[contained ? 'section container' : 'cta-section', className]}
  aria-labelledby={id}
  data-cta-banner
>
  <div class="final-cta">
    <p class="section-kicker">// 04 — let's talk</p>

    <div class="cta-grid">
      <div class="cta-copy-wrap">
        <h2 id={id}>Have a project in mind? Let's build something exceptional.</h2>
        <p class="cta-copy">
          Available for freelance design, full-stack development, and security audits — reach out to discuss your goals.
        </p>
      </div>

      <div class="cta-side">
        <div class="email-wrap">
          <div class="email-display">
            <span class="email-icon" aria-hidden="true">@</span>
            <span class="email-address">{site.email}</span>
          </div>
          <div class="toast" data-toast role="status" aria-live="polite">Copied!</div>
        </div>

        <div class="final-actions">
          <a class="btn btn-primary" href={inquiryHref} data-magnetic>
            <span>Start a project</span><span aria-hidden="true">→</span>
          </a>
          <button
            class="btn btn-ghost"
            type="button"
            data-magnetic
            data-copy-email
            data-email={site.email}
          >
            <span data-copy-label>Copy Email</span><span aria-hidden="true">⧉</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCopyEmail } from '../scripts/copy-email.js';

  document.querySelectorAll('[data-cta-banner]').forEach((root) => initCopyEmail(root));
</script>

<style>
  .cta-section {
    margin-top: var(--space-section);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .btn {
    --mag-x: 0px;
    --mag-y: 0px;
    --btn-x: 50%;
    --btn-y: 50%;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transform: translate3d(var(--mag-x), var(--mag-y), 0);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 220ms ease,
      border-color 220ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      180px circle at var(--btn-x) var(--btn-y),
      color-mix(in srgb, var(--color-accent) 45%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .btn:hover::after {
    opacity: 0.55;
  }

  .final-cta {
    --cta-text: #f8fafc;
    --cta-muted: #a7c9bd;
    --cta-accent: #4ade80;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(2rem, 5.5vw, 4rem);
    border: 1px solid rgb(74 222 128 / 0.26);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 86% 8%, rgb(74 222 128 / 0.16), transparent 42%),
      radial-gradient(circle at 0% 100%, rgb(15 118 110 / 0.18), transparent 48%),
      linear-gradient(145deg, rgb(10 22 24 / 0.96), rgb(4 15 19 / 0.95));
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.34), inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 0 50px rgb(74 222 128 / 0.07);
    color: var(--cta-text);
    text-align: left;
  }

  .final-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(148 184 176 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 184 176 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(120deg, #000, transparent 72%);
    mask-image: linear-gradient(120deg, #000, transparent 72%);
  }

  .final-cta .section-kicker {
    color: var(--cta-accent);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .final-cta h2 {
    max-width: 20ch;
    margin-top: 1rem;
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .cta-copy {
    max-width: 54ch;
    margin-top: 1.1rem;
    color: var(--cta-muted);
    font-size: clamp(0.92rem, 1.4vw, 1rem);
  }

  .cta-side {
    display: grid;
    justify-self: end;
    width: 100%;
    gap: 0.85rem;
  }

  .email-wrap {
    position: relative;
  }

  .email-display {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(74 222 128 / 0.24);
    border-radius: 14px;
    background: rgb(4 15 19 / 0.62);
    color: var(--cta-text);
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.25vw, 0.92rem);
    text-align: left;
  }

  .email-icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: 50%;
    background: rgb(74 222 128 / 0.14);
    color: var(--cta-accent);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .email-address {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.7rem;
  }

  .final-cta .btn-primary {
    background: #4ade80;
    color: #020617;
    font-weight: 600;
  }

  .final-cta .btn-primary:hover {
    background: #34d399;
    box-shadow: 0 14px 34px rgb(52 211 153 / 0.22);
  }

  .final-cta .btn-ghost {
    border-color: rgb(248 250 252 / 0.22);
    background: rgb(255 255 255 / 0.03);
    color: var(--cta-text);
  }

  .final-cta .btn-ghost:hover {
    border-color: rgb(74 222 128 / 0.6);
    background: rgb(74 222 128 / 0.08);
    color: var(--cta-accent);
  }

  .toast {
    position: absolute;
    right: 0.75rem;
    bottom: calc(100% + 0.5rem);
    padding: 0.35rem 0.65rem;
    border: 1px solid rgb(74 222 128 / 0.4);
    border-radius: 999px;
    background: #0b1e20;
    color: var(--cta-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .toast::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 1rem;
    border: 5px solid transparent;
    border-top-color: rgb(74 222 128 / 0.4);
  }

  .toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .cta-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cta-side {
      justify-self: stretch;
    }

    .final-actions {
      justify-content: flex-start;
    }
  }
</style>
