---
import { site } from '../data/site.js';
import { socials } from '../data/socials.js';

const isExternal = (href) => /^https?:\/\//.test(href);
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <picture>
        <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
        <img class="footer-photo" src="/niroj.png?v=20261122b" width="36" height="36" alt="" />
      </picture>
      <div>
        <strong>{site.name}</strong>
        <p>{site.location} · {site.availability}</p>
      </div>
    </div>

    <nav aria-label="Elsewhere">
      <p class="footer-label">Elsewhere</p>
      <ul class="footer-links">
        {socials.map((social) => (
          <li>
            <a
              class="chip"
              href={social.href}
              aria-label={`${social.label}: ${social.handle}`}
              rel={isExternal(social.href) ? 'noopener noreferrer' : undefined}
            >
              {social.label}
            </a>
          </li>
        ))}
        <li><a class="chip" href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-border);
    background: linear-gradient(0deg, var(--color-accent-soft), transparent 65%);
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand picture {
    display: contents;
  }

  .footer-photo {
    width: 36px;
    height: 36px;
    flex: none;
    border: 2px solid var(--color-accent);
    border-radius: 10px;
    object-fit: cover;
    object-position: center;
    background: var(--color-surface);
  }

  .footer-brand strong {
    font-size: 1.1rem;
  }

  .footer-brand p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .footer-label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    border-color: var(--color-accent-line);
    color: var(--color-link);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .footer-bottom a {
    text-decoration: none;
  }
</style>
