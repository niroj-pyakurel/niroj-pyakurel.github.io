---
import { site } from '../data/site.js';
import { navigation } from '../data/navigation.js';
import { socials } from '../data/socials.js';

const isExternal = (href) => /^https?:\/\//.test(href);
const status = `${site.location} · Available for work`;
const socialIconPaths = {
  Email: ['M4 6h16v12H4z', 'm4 7 8 6 8-6'],
  LinkedIn: ['M6 9v10', 'M6 6.5v.01', 'M10 19V9', 'M10 13.5a3.5 3.5 0 0 1 7 0V19'],
  GitHub: [
    'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.1-1.5 6.1-6.5A5.1 5.1 0 0 0 19.1 4a4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.9 1.4a13.4 13.4 0 0 0-7 0C5.4.1 4.2.4 4.2.4A4.8 4.8 0 0 0 4.1 4a5.1 5.1 0 0 0-1.1 3.5c0 5 3 6.2 6.1 6.5A3.4 3.4 0 0 0 8.2 17v4',
  ],
};
---

<footer class="site-footer">
  <div class="footer-container footer-main">
    <div class="footer-brand">
      <picture>
        <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
        <img class="footer-photo" src="/niroj.png?v=20261122b" width="44" height="44" alt="" />
      </picture>
      <div class="footer-brand-copy">
        <strong>{site.name}</strong>
        <p>{status}</p>
      </div>
    </div>

    <div class="footer-columns">
      <nav class="footer-nav" aria-label="Pages">
        <p class="footer-label">Pages</p>
        <ul class="footer-links">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Elsewhere">
        <p class="footer-label">Elsewhere</p>
        <ul class="footer-links">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                rel={isExternal(social.href) ? 'noopener noreferrer' : undefined}
              >
                <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {socialIconPaths[social.label].map((path) => <path d={path} />)}
                </svg>
                <span>{social.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer-container footer-bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    background: linear-gradient(0deg, var(--color-accent-soft), transparent 65%);
  }

  .footer-container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .footer-main {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.25rem 1.5rem;
  }

  .footer-main::before {
    content: '';
    position: absolute;
    top: 0;
    right: 1.25rem;
    left: 1.25rem;
    height: 1px;
    background: var(--color-border);
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .footer-brand picture {
    display: contents;
  }

  .footer-photo {
    width: 44px;
    height: 44px;
    flex: none;
    border: 2px solid var(--color-accent);
    border-radius: 12px;
    object-fit: cover;
    object-position: center;
    background: var(--color-surface);
  }

  .footer-brand-copy {
    min-width: 0;
  }

  .footer-brand strong {
    display: block;
    font-size: 1rem;
    line-height: 1.2;
  }

  .footer-brand p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: clamp(0.68rem, 3.1vw, 0.8rem);
    line-height: 1.35;
    white-space: nowrap;
  }

  .footer-columns {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-nav {
    min-width: 0;
  }

  .footer-label {
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .footer-nav:last-child .footer-links {
    gap: 0.625rem 1rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition), transform var(--transition);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-link);
    transform: translateX(2px);
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    opacity: 0.85;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .footer-bottom::before {
    content: '';
    position: absolute;
    top: 0;
    right: 1.25rem;
    left: 1.25rem;
    height: 1px;
    background: var(--color-border);
  }

  .footer-bottom p,
  .footer-bottom a {
    margin: 0;
    white-space: nowrap;
    transition: color var(--transition), transform var(--transition);
  }

  .footer-bottom a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer-bottom a:hover,
  .footer-bottom a:focus-visible {
    color: var(--color-link);
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .footer-container {
      padding-inline: 2rem;
    }

    .footer-main::before,
    .footer-bottom::before {
      right: 2rem;
      left: 2rem;
    }
  }

  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
      padding-block: 3rem 2rem;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-columns {
      flex-direction: row;
      gap: clamp(3rem, 6vw, 5rem);
    }

    .footer-links,
    .footer-nav:last-child .footer-links {
      gap: 0.625rem 1.25rem;
    }
  }
</style>
