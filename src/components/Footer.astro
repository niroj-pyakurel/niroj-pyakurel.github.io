---
import { site } from '../data/site.js';
import { socials } from '../data/socials.js';

const isExternal = (href) => /^https?:\/\//.test(href);
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <svg viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="37" height="37" rx="9" stroke="var(--color-accent)" stroke-width="2" />
        <path d="M9 30V10l10 20V10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M24 30V10h5a5 5 0 0 1 0 10h-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div>
        <strong>{site.name}</strong>
        <p>{site.location} · {site.availability}</p>
      </div>
    </div>

    <nav aria-label="Elsewhere">
      <p class="footer-label">Elsewhere</p>
      <ul class="footer-links">
        {socials.map((social) => (
          <li>
            <a
              class="chip"
              href={social.href}
              aria-label={`${social.label}: ${social.handle}`}
              rel={isExternal(social.href) ? 'noopener noreferrer' : undefined}
            >
              {social.label}
            </a>
          </li>
        ))}
        <li><a class="chip" href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-border);
    background: linear-gradient(0deg, var(--color-accent-soft), transparent 65%);
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand strong {
    font-size: 1.1rem;
  }

  .footer-brand p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .footer-label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    border-color: var(--color-accent-line);
    color: var(--color-link);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .footer-bottom a {
    text-decoration: none;
  }
</style>
