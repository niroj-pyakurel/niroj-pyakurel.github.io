---
import { navigation } from '../data/navigation.js';
import { site } from '../data/site.js';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path === href.replace(/\/+$/, ''));
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <svg
        class="brand-mark"
        viewBox="0 0 40 40"
        width="34"
        height="34"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="1.5" y="1.5" width="37" height="37" rx="9" stroke="var(--color-accent)" stroke-width="2" />
        <path
          d="M9 30V10l10 20V10"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M24 30V10h5a5 5 0 0 1 0 10h-5"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="wordmark">{site.name}</span>
    </a>

    <div class="header-right">
      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ThemeToggle />

      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open navigation menu"
        title="Open navigation menu"
      >
        <span class="menu-lines" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { initMobileNav } from '../scripts/navigation.js';

  initMobileNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 45%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .brand:hover .wordmark {
    color: var(--color-link);
  }

  .brand-mark {
    flex: none;
  }

  .wordmark {
    white-space: nowrap;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    color: var(--color-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current='page'] {
    color: var(--color-link);
  }

  .primary-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--transition), background-color var(--transition), box-shadow var(--transition);
  }

  .menu-toggle:hover {
    border-color: var(--color-accent-line);
    box-shadow: var(--shadow-soft);
  }

  .menu-lines {
    display: grid;
    gap: 4px;
    width: 1.05rem;
  }

  .menu-lines > span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--transition), opacity var(--transition);
  }

  .site-header[data-menu-open='true'] .menu-lines > span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header[data-menu-open='true'] .menu-lines > span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-menu-open='true'] .menu-lines > span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: nowrap;
      padding-block: 0.75rem;
    }

    .header-right {
      gap: 0.55rem;
      flex-wrap: nowrap;
    }

    .menu-toggle {
      display: inline-grid;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      padding: 0.75rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--header-bg);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-card);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
    }

    .site-header[data-menu-open='true'] .primary-nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
    }

    .primary-nav ul {
      display: grid;
      gap: 0.35rem;
    }

    .primary-nav a {
      display: block;
      padding: 0.8rem 0.95rem;
      border: 1px solid transparent;
      border-radius: var(--radius);
      font-size: 0.95rem;
    }

    .primary-nav a:hover,
    .primary-nav a[aria-current='page'] {
      border-color: var(--color-accent-line);
      background: var(--color-accent-soft);
      text-decoration: none;
    }
  }

  @media (max-width: 380px) {
    .wordmark {
      font-size: 0.9rem;
    }

    .header-inner {
      gap: 0.6rem;
    }
  }
</style>
