---
import { navigation } from '../data/navigation.js';
import { site } from '../data/site.js';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path === href.replace(/\/+$/, ''));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <img class="brand-photo" src="/profile-photo.png" width="34" height="34" alt="" />
      <span class="wordmark">{site.name}</span>
    </a>

    <div class="header-right">
      <nav class="primary-nav" aria-label="Primary navigation">
        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 45%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .brand:hover .wordmark {
    color: var(--color-link);
  }

  .brand-photo {
    width: 34px;
    height: 34px;
    flex: none;
    border: 2px solid var(--color-accent);
    border-radius: 10px;
    object-fit: cover;
    object-position: center;
    background: var(--color-surface);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    color: var(--color-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current='page'] {
    color: var(--color-link);
  }

  .primary-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 760px) {
    .header-inner {
      align-items: center;
      padding-block: 0.75rem;
    }

    .header-right {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .primary-nav {
      min-width: 0;
      flex: 1;
    }

    .primary-nav ul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.35rem 0.5rem;
      text-align: center;
    }

    .primary-nav a {
      display: block;
      padding: 0.35rem 0.25rem;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 0.78rem;
    }

    .primary-nav a[aria-current='page'] {
      border-color: var(--color-accent-line);
      background: var(--color-accent-soft);
      text-decoration: none;
    }
  }
</style>
