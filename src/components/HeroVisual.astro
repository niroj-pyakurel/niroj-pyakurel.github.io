---
import { site } from '../data/site.js';
---

<div class="hero-visual" aria-hidden="true">
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>

  <div class="float float-identity">
    <div class="identity">
      <div class="portrait">
        <picture>
          <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
          <img src="/niroj.png?v=20261122b" width="96" height="96" alt="" />
        </picture>
      </div>
      <div class="identity-copy">
        <span class="mini-label">Based in</span>
        <strong>{site.location}</strong>
        <span class="status"><span class="status-dot"></span>{site.availability}</span>
      </div>
    </div>
  </div>

  <div class="float float-code">
    <div class="visual-card code-card">
      <div class="card-bar">
        <span></span><span></span><span></span>
        <em>niroj.py</em>
      </div>
      <div class="code-lines">
        <p><span class="key">name</span> = <span class="str">'Niroj Pyakurel'</span></p>
        <p><span class="key">base</span> = <span class="str">'Kathmandu, NP'</span></p>
        <p><span class="key">focus</span> = [<span class="str">'design'</span>, <span class="str">'web'</span>, <span class="str">'security'</span>]</p>
        <p><span class="key">status</span> = <span class="str">'available'</span></p>
      </div>
    </div>
  </div>

  <div class="float float-tools">
    <div class="visual-card tool-card">
      <div class="tool-group">
        <span class="mini-label">Security tools</span>
        <ul class="chip-list">
          {site.security.tools.map((tool) => <li class="chip chip-accent">{tool}</li>)}
        </ul>
      </div>
      <div class="tool-group">
        <span class="mini-label">Creative tools</span>
        <ul class="chip-list">
          {site.designTools.map((tool) => <li class="chip chip-amber">{tool}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  const visual = document.querySelector('.hero-visual');
  const hero = visual?.closest('.hero');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && visual && finePointer.matches && !reducedMotion.matches) {
    hero.addEventListener('pointermove', (event) => {
      const rect = visual.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      visual.style.setProperty('--mx', `${x.toFixed(1)}%`);
      visual.style.setProperty('--my', `${y.toFixed(1)}%`);
    });
  }
</script>

<style>
  .hero-visual {
    position: relative;
    display: grid;
    gap: 1rem;
    isolation: isolate;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -14%;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 40%),
      color-mix(in srgb, var(--color-accent) 12%, transparent),
      transparent 72%
    );
    opacity: 0;
    transition: opacity 700ms ease;
    pointer-events: none;
  }

  .hero-visual:hover::before {
    opacity: 1;
  }

  .float {
    will-change: transform;
  }

  .float-identity {
    animation:
      fade-in 900ms ease both,
      float-soft 17s ease-in-out 1.2s infinite;
  }

  .float-code {
    animation:
      fade-in 900ms ease 120ms both,
      float-alt 21s ease-in-out -4s infinite;
  }

  .float-tools {
    animation:
      fade-in 900ms ease 240ms both,
      float-soft 24s ease-in-out -9s infinite;
  }

  .orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid var(--color-accent-line);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    inset: -6% -4% 24% 10%;
    opacity: 0.5;
    animation: orbit-spin 110s linear infinite;
  }

  .orbit-two {
    inset: 28% 4% -8% -6%;
    border-color: var(--color-teal-line);
    opacity: 0.45;
    animation: orbit-spin 150s linear infinite reverse;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portrait {
    width: clamp(4rem, 9vw, 5.5rem);
    aspect-ratio: 1;
    flex: none;
    overflow: hidden;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 6px var(--color-accent-soft);
    animation: portrait-glow 9s ease-in-out infinite;
  }

  .portrait picture {
    display: contents;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .identity-copy {
    display: grid;
    gap: 0.25rem;
  }

  .mini-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .identity-copy strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .visual-card {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-card);
  }

  .code-card {
    overflow: hidden;
  }

  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 0.95rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .card-bar span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .card-bar span:first-child {
    background: var(--color-accent-2);
  }

  .card-bar em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-style: normal;
    color: var(--color-muted);
  }

  .code-lines {
    display: grid;
    gap: 0.6rem;
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 1.1vw, 0.78rem);
    line-height: 1.5;
    overflow-x: auto;
  }

  .code-lines p {
    white-space: nowrap;
    color: var(--color-muted);
  }

  .key {
    color: var(--color-link);
  }

  .str {
    color: var(--color-accent-2);
  }

  .tool-card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .tool-group .mini-label {
    display: block;
    margin-bottom: 0.7rem;
  }

  .visual-card {
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .visual-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-line);
    box-shadow: 0 26px 64px rgb(0 0 0 / 0.34);
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes float-soft {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -6px, 0); }
  }

  @keyframes float-alt {
    0%, 100% { transform: translate3d(0, -3px, 0); }
    50% { transform: translate3d(0, 4px, 0); }
  }

  @keyframes orbit-spin {
    to { transform: rotate(1turn); }
  }

  @keyframes portrait-glow {
    0%, 100% { box-shadow: 0 0 0 6px var(--color-accent-soft); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-accent) 7%, transparent); }
  }

  @media (max-width: 900px) {
    .orbit {
      display: none;
    }
  }
</style>
