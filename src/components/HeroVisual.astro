---
import { site } from '../data/site.js';
---

<div class="hero-visual" aria-hidden="true">
  <div class="glow"></div>
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>

  <div class="visual-mark">NP</div>

  <div class="visual-card code-card">
    <div class="card-bar">
      <span></span><span></span><span></span>
      <em>niroj.py</em>
    </div>
    <div class="code-lines">
      <p><span class="key">name</span> = <span class="str">'Niroj Pyakurel'</span></p>
      <p><span class="key">base</span> = <span class="str">'Kathmandu, NP'</span></p>
      <p><span class="key">focus</span> = [<span class="str">'design'</span>, <span class="str">'web'</span>, <span class="str">'security'</span>]</p>
      <p><span class="key">status</span> = <span class="str">'available'</span></p>
    </div>
  </div>

  <div class="visual-card tool-card">
    <div class="tool-group">
      <span class="mini-label">Security</span>
      <ul class="chip-list">
        {site.security.tools.map((tool) => <li class="chip chip-accent">{tool}</li>)}
      </ul>
    </div>
    <div class="tool-group">
      <span class="mini-label">Creative</span>
      <ul class="chip-list">
        {site.designTools.map((tool) => <li class="chip chip-teal">{tool}</li>)}
      </ul>
    </div>
  </div>

  <div class="visual-status"><span class="status-dot"></span>{site.availability}</div>
</div>

<style>
  .hero-visual {
    position: relative;
    min-height: 460px;
    isolation: isolate;
  }

  .glow {
    position: absolute;
    inset: 12% 8% 18% 12%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-accent-soft), transparent 68%);
  }

  .orbit {
    position: absolute;
    border: 1px solid var(--color-accent-line);
    border-radius: 26px;
  }

  .orbit-one {
    inset: 8% 10% 12% 8%;
    transform: rotate(-9deg);
  }

  .orbit-two {
    inset: 20% 2% 4% 22%;
    border-color: var(--color-teal-line);
    transform: rotate(11deg);
  }

  .visual-mark {
    position: absolute;
    top: 3%;
    right: 3%;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.1em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-accent-line);
  }

  .visual-card {
    position: absolute;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-card);
    animation: float 8s ease-in-out infinite;
  }

  .code-card {
    top: 14%;
    left: 0;
    width: min(100%, 440px);
    overflow: hidden;
  }

  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 0.95rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .card-bar span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .card-bar span:first-child {
    background: var(--color-accent);
  }

  .card-bar em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-style: normal;
    color: var(--color-muted);
  }

  .code-lines {
    display: grid;
    gap: 0.6rem;
    padding: 1.35rem;
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 1.15vw, 0.78rem);
    line-height: 1.5;
    overflow-x: auto;
  }

  .code-lines p {
    white-space: nowrap;
    color: var(--color-muted);
  }

  .key {
    color: var(--color-link);
  }

  .str {
    color: var(--color-accent-2);
  }

  .tool-card {
    right: 0;
    bottom: 8%;
    display: grid;
    gap: 1rem;
    width: min(90%, 330px);
    padding: 1.2rem;
    animation-delay: -4s;
  }

  .mini-label {
    display: block;
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .visual-status {
    position: absolute;
    left: 5%;
    bottom: 1%;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 999px;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    box-shadow: var(--shadow-card);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Keep the same visual language on small screens instead of hiding it. */
  @media (max-width: 900px) {
    .hero-visual {
      min-height: 0;
    }

    .orbit,
    .visual-status {
      display: none;
    }

    .code-card {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      animation: none;
    }

    .tool-card {
      position: relative;
      right: auto;
      bottom: auto;
      width: 100%;
      margin-top: 0.85rem;
      animation: none;
    }

    .visual-mark {
      top: -1.5rem;
      font-size: 4rem;
    }
  }
</style>
