---
import { site } from '../data/site.js';
---

<div class="hero-visual" aria-hidden="true">
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>

  <div class="float float-identity">
    <div class="mini-card identity-card">
      <span class="card-label">01 · BASE</span>
      <div class="identity">
        <div class="portrait">
          <picture>
            <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
            <img src="/niroj.png?v=20261122b" width="96" height="96" alt="" />
          </picture>
        </div>
        <div class="identity-copy">
          <span class="mini-label">Based in</span>
          <strong>{site.location}</strong>
          <span class="status"><span class="status-dot"></span>{site.availability}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="float float-code">
    <div class="mini-card code-card">
      <div class="card-bar">
        <span class="card-label">02 · FOCUS</span>
        <span class="window-dots"><i></i><i></i><i></i></span>
        <em>niroj.py</em>
      </div>
      <div class="code-lines">
        <p><span class="key">name</span> = <span class="str">'Niroj Pyakurel'</span></p>
        <p><span class="key">base</span> = <span class="str">'Kathmandu, NP'</span></p>
        <p><span class="key">focus</span> = [<span class="str">'design'</span>, <span class="str">'web'</span>, <span class="str">'security'</span>]</p>
        <p><span class="key">status</span> = <span class="str">'available'</span></p>
      </div>
    </div>
  </div>

  <div class="float float-tools">
    <div class="mini-card tool-card">
      <span class="card-label">03 · TOOLS</span>
      <div class="tool-group">
        <span class="mini-label">Security tools</span>
        <ul class="chip-list">
          {site.security.tools.map((tool) => <li class="chip chip-accent">{tool}</li>)}
        </ul>
      </div>
      <div class="tool-group">
        <span class="mini-label">Creative tools</span>
        <ul class="chip-list">
          {site.designTools.map((tool) => <li class="chip chip-amber">{tool}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-visual {
    position: relative;
    display: grid;
    gap: 2.25rem;
    isolation: isolate;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: -1.15rem;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-accent-line) 12%,
      var(--color-accent-line) 88%,
      transparent
    );
    opacity: 0.7;
    pointer-events: none;
  }

  .float {
    will-change: transform;
  }

  .float-identity {
    animation: float-soft 8s ease-in-out infinite;
  }

  .float-code {
    animation: float-alt 10s ease-in-out infinite;
    animation-delay: -2.5s;
  }

  .float-tools {
    animation: float-soft 12s ease-in-out infinite;
    animation-delay: -6s;
  }

  .orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid var(--color-accent-line);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    inset: -6% -4% 24% 10%;
    opacity: 0.3;
    animation: orbit-spin 48s linear infinite;
  }

  .orbit-two {
    inset: 28% 4% -8% -6%;
    border-style: dashed;
    border-color: var(--color-teal-line);
    opacity: 0.22;
    animation: orbit-spin 64s linear infinite reverse;
  }

  .mini-card {
    position: relative;
    z-index: 1;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .mini-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-line);
    box-shadow: 0 26px 64px rgb(0 0 0 / 0.34);
  }

  .card-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--color-link);
  }

  .identity-card {
    padding: 1rem 1.15rem 1.2rem;
    background:
      linear-gradient(120deg, var(--color-accent-soft), transparent 70%),
      var(--color-surface-raised);
  }

  .identity-card .card-label {
    margin-bottom: 0.9rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portrait {
    width: clamp(4rem, 9vw, 5.5rem);
    aspect-ratio: 1;
    flex: none;
    overflow: hidden;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 5px var(--color-accent-soft);
  }

  .portrait picture {
    display: contents;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .identity-copy {
    display: grid;
    gap: 0.25rem;
  }

  .mini-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .identity-copy strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .code-card {
    overflow: hidden;
  }

  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.95rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .window-dots {
    display: flex;
    gap: 0.35rem;
    margin-left: auto;
  }

  .window-dots i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .window-dots i:first-child {
    background: var(--color-accent-2);
  }

  .card-bar em {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-style: normal;
    color: var(--color-muted);
  }

  .code-lines {
    display: grid;
    gap: 0.6rem;
    padding: 1.15rem;
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 1.1vw, 0.78rem);
    line-height: 1.5;
    overflow-x: auto;
  }

  .code-lines p {
    white-space: nowrap;
    color: var(--color-muted);
  }

  .key {
    color: var(--color-link);
  }

  .str {
    color: var(--color-accent-2);
  }

  .tool-card {
    display: grid;
    gap: 1rem;
    padding: 1.2rem 1.25rem 1.3rem;
  }

  .tool-card > .card-label {
    margin-bottom: 0.2rem;
  }

  .tool-group .mini-label {
    display: block;
    margin-bottom: 0.6rem;
  }

  @keyframes float-soft {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -5px, 0); }
  }

  @keyframes float-alt {
    0%, 100% { transform: translate3d(0, -2px, 0); }
    50% { transform: translate3d(0, 4px, 0); }
  }

  @keyframes orbit-spin {
    to { transform: rotate(1turn); }
  }

  @media (max-width: 900px) {
    .hero-visual::before,
    .orbit {
      display: none;
    }
  }
</style>
