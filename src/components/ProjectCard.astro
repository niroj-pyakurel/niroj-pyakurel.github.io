---
import Tag from './Tag.astro';

const { title, description, tags = [], href, date, featured = false } = Astro.props;
const hasMedia = Astro.slots.has('media');
const when = date
  ? new Date(date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : 'Project';
---

<article class:list={['project-card', 'panel', { featured, 'with-media': hasMedia }]} data-tags={tags.join(' ')}>
  <div class="card-content">
    <div class="card-meta">
      <p class="eyebrow">{when}</p>
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => <li><Tag label={tag} /></li>)}
        </ul>
      )}
    </div>

    <h3><a href={href}>{title}</a></h3>
    <p class="description">{description}</p>

    <a class="card-link" href={href}>
      Read case study <span aria-hidden="true">→</span>
    </a>
  </div>

  {hasMedia && <div class="card-media"><slot name="media" /></div>}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-line);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    padding: 1.75rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 1.4rem;
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-link);
  }

  .description {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .card-link span {
    transition: transform var(--transition);
  }

  .card-link:hover span {
    transform: translateX(4px);
  }

  .card-media {
    padding: 0 1.25rem 1.25rem;
  }

  @media (min-width: 780px) {
    .project-card.with-media {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }

    .project-card.with-media .card-media {
      padding: 1.25rem 1.25rem 1.25rem 0;
    }
  }
</style>
