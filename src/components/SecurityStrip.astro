---
import { site } from '../data/site.js';
---

<aside class="security-strip" aria-labelledby="security-strip-title">
  <div class="security-intro">
    <p class="eyebrow">{site.security.label}</p>
    <h2 id="security-strip-title">Security is part of the work</h2>
    <p>{site.security.note}</p>
  </div>
  <dl>
    <div>
      <dt>Toolbox</dt>
      <dd>{site.security.tools.join(' · ')}</dd>
    </div>
    <div>
      <dt>Certifications</dt>
      <dd>{site.security.certifications.join(' · ')}</dd>
    </div>
  </dl>
</aside>

<style>
  .security-strip {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .eyebrow {
    color: var(--color-link);
  }

  h2 {
    margin-top: 0.6rem;
    font-size: 1.4rem;
  }

  .security-intro p:last-child {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  dd {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
  }

  @media (min-width: 860px) {
    .security-strip {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }
  }
</style>
