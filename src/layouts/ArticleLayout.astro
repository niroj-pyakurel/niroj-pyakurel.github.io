---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';

const {
  title,
  description,
  eyebrow = 'Case study',
  date,
  tags = [],
  readingTime,
  securityNotes,
  backHref,
  backLabel = 'All work',
  prev,
  next,
} = Astro.props;

const when = date
  ? new Date(date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<BaseLayout title={title} description={description} type="article">
  <article class="article container">
    <header class="article-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="article-lede">{description}</p>
      <div class="article-meta">
        {when && <time datetime={new Date(date).toISOString().slice(0, 10)}>{when}</time>}
        {readingTime && <span>{readingTime}</span>}
        {tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => <li><Tag label={tag} /></li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="prose article-body">
      <slot />
    </div>

    {securityNotes && (
      <section class="security-notes" aria-labelledby="security-notes-title">
        <p class="eyebrow">Security lens</p>
        <h2 id="security-notes-title">Security notes</h2>
        <p>{securityNotes}</p>
      </section>
    )}

    <footer class="article-footer">
      <a class="back-link" href={backHref}>← {backLabel}</a>
      {(prev || next) && (
        <nav class="article-nav" aria-label="More articles">
          {prev && <a href={prev.href} rel="prev">← {prev.title}</a>}
          {next && <a href={next.href} rel="next">{next.title} →</a>}
        </nav>
      )}
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .article-header h1 {
    max-width: 20ch;
    margin-top: 1rem;
  }

  .article-lede {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 62ch;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .article-body {
    margin-top: 3rem;
  }

  .security-notes {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .security-notes h2 {
    margin-top: 0.5rem;
    font-size: 1.4rem;
  }

  .security-notes > p:last-child {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .article-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .back-link {
    text-decoration: none;
  }

  .article-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .article-nav a:hover {
    color: var(--color-link);
  }
</style>
