---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.js';
import { experience } from '../data/experience.js';

const stats = [
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
];

const principles = [
  {
    number: '01',
    title: 'Clarity',
    copy: 'Start with the real goal, strip out the noise, and make the next step obvious to everyone involved.',
  },
  {
    number: '02',
    title: 'Consistency',
    copy: 'Keep the same care from first sketch to final handoff — in the visuals, the code, and the documentation.',
  },
  {
    number: '03',
    title: 'Security by Default',
    copy: 'Treat basic checks and clear findings as part of normal delivery, not an afterthought at the end.',
  },
];
---

<BaseLayout title="About" description={site.about.lead}>
  <div class="container page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-intro">
        <SectionHeading as="h1" eyebrow="About" title="Design, code and security in one toolkit" id="about-title" />
        <p class="hero-note">{site.about.lead}</p>

        <ul class="stats">
          {stats.map((stat) => (
            <li class="panel">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="glance-card panel" aria-labelledby="glance-title">
        <div class="glance-head">
          <p class="eyebrow">At a glance</p>
          <h2 id="glance-title">Focus areas</h2>
        </div>

        <ul class="focus-list">
          {site.services.map((service, index) => (
            <li>
              <span class="focus-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{service.title}</strong>
                <p>{service.description}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="glance-footer">
          <span>{site.location}</span>
          <a href="/contact/">Available for freelance work <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </section>

    <section class="block story-section" aria-labelledby="story-title">
      <SectionHeading eyebrow="Background" title="A short story" id="story-title" index="01" />
      <div class="story-layout">
        <div class="prose story">
          <p class="lead">{site.about.lead}</p>
          {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>{site.about.closing}</p>
          <a class="story-link" href="/contact/">Let's talk about your project <span aria-hidden="true">→</span></a>
        </div>

        <figure class="story-portrait">
          <picture>
            <source srcset="/niroj-portrait.webp?v=20261122d" type="image/webp" />
            <img
              src="/niroj-portrait.png?v=20261122d"
              width="768"
              height="1024"
              loading="lazy"
              alt="Portrait of Niroj Pyakurel"
            />
          </picture>
          <span class="portrait-tag" aria-hidden="true">NP / 01</span>
          <figcaption>
            <span>Based in {site.location}</span>
            <strong>{site.name}</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="block" aria-labelledby="skills-title">
      <SectionHeading eyebrow="Toolkit" title="Skills" id="skills-title" index="02">
        Grouped the way I actually use them — language, systems, security and the people side.
      </SectionHeading>
      <div class="skill-grid">
        {site.skills.map((group) => (
          <article class="skill-group panel">
            <div class="skill-head">
              <span class="skill-count">{String(group.items.length).padStart(2, '0')}</span>
              <h3>{group.label}</h3>
            </div>
            <ul class="chip-list">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="background-title">
      <SectionHeading eyebrow="Background" title="Experience & education" id="background-title" index="03" />

      <h3 class="subsection-title">Roles held</h3>
      <ol class="timeline">
        {experience.map((item, index) => (
          <li>
            <span class="timeline-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="timeline-body">
              <div class="timeline-head">
                <div>
                  <strong>{item.role}</strong>
                  <span>{item.organization}</span>
                </div>
                <span class="period">{item.period}</span>
              </div>
              <ul class="timeline-highlights">
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <h3 class="subsection-title">Education & certifications</h3>
      <div class="detail-grid">
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-5 9 5-9 5-9-5Z" />
                <path d="M7 11v5c0 1.5 2.2 3 5 3s5-1.5 5-3v-5" />
              </svg>
            </span>
            <h3>Education</h3>
          </div>
          <ul class="details">
            {site.education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span>{item.school}</span>
                <span class="muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5c0 4.5 2.8 8.4 7 10 4.2-1.6 7-5.5 7-10V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>
            <h3>Certifications</h3>
          </div>
          <ul class="details">
            {site.certifications.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.issuer}</span>
                <span class="muted">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="approach-title">
      <SectionHeading eyebrow="How I work" title="Clarity, consistency, teamwork" id="approach-title" index="04">
        Good work depends on knowing what matters, keeping it consistent, and communicating clearly while you do it.
      </SectionHeading>
      <div class="principles panel">
        <div class="principle-grid">
          {principles.map((principle) => (
            <article class="principle">
              <span class="principle-number" aria-hidden="true">{principle.number}</span>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <CTABanner />
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .about-hero {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .about-intro h1 {
    max-width: 18ch;
  }

  .hero-note {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .stats strong {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-link);
  }

  .stats span {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .glance-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 2rem);
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 52%),
      var(--color-surface);
  }

  .glance-head h2 {
    margin-top: 0.6rem;
    font-size: 1.5rem;
  }

  .focus-list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    display: flex;
    gap: 0.9rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .focus-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .focus-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .focus-list strong {
    display: block;
    font-size: 0.98rem;
  }

  .focus-list p {
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .glance-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .glance-footer span {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .glance-footer a {
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .block {
    margin-top: var(--space-section);
  }

  .story-layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    align-items: stretch;
  }

  .story {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--color-surface);
  }

  .story .lead {
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .story p + p {
    margin-top: 1.25rem;
    color: var(--color-muted);
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-accent-line);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: none;
    transition: gap var(--transition), color var(--transition);
  }

  .story-link:hover {
    gap: 0.85rem;
    color: var(--color-accent);
  }

  .story-portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    min-height: 24rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-lg);
    background: var(--color-bg-deep);
    box-shadow: var(--shadow-card);
  }

  .story-portrait::after {
    content: '';
    position: absolute;
    inset: 28% 0 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(3 14 18 / 0.48) 40%,
      var(--caption-scrim) 100%
    );
    pointer-events: none;
  }

  .story-portrait picture {
    display: contents;
  }

  .story-portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .story-portrait:hover img {
    transform: scale(1.04);
  }

  .portrait-tag {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgb(141 240 198 / 0.35);
    border-radius: 999px;
    background: rgb(3 14 18 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--caption-accent);
  }

  .story-portrait figcaption {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    display: grid;
    gap: 0.35rem;
    isolation: isolate;
    padding: 1rem 1.15rem;
    border: 1px solid rgb(141 240 198 / 0.24);
    border-radius: var(--radius);
    background: rgb(3 14 18 / 0.52);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--caption-ink);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.5);
  }

  .story-portrait figcaption span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--caption-accent);
  }

  .story-portrait figcaption strong {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    letter-spacing: -0.03em;
    color: var(--caption-ink);
  }

  .subsection-title {
    margin-top: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .timeline {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0 0 0 1.5rem;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .timeline li {
    position: relative;
  }

  .timeline-index {
    position: absolute;
    top: 1.25rem;
    left: -2.35rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 50%;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-link);
  }

  .timeline-body {
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .timeline-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .timeline-head strong {
    display: block;
    font-size: 1.05rem;
  }

  .timeline-head div span {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .timeline-highlights {
    margin-top: 1rem;
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .timeline-highlights li + li {
    margin-top: 0.35rem;
  }

  .principles {
    margin-top: 2rem;
    overflow: hidden;
  }

  .principle-grid {
    display: grid;
  }

  .principle {
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .principle + .principle {
    border-top: 1px solid var(--color-border);
  }

  .principle-number {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .principle h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
  }

  .principle p {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .skill-grid,
  .detail-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .skill-group {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .skill-group:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-line);
    box-shadow: var(--shadow-card);
  }

  .skill-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .skill-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .detail-panel {
    padding: 1.75rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .detail-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .detail-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .detail-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .details {
    padding: 0;
    list-style: none;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.1rem;
  }

  .details li + li {
    border-top: 1px solid var(--color-border);
  }

  .details span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    color: var(--color-link) !important;
  }

  @media (min-width: 900px) {
    .about-hero {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: stretch;
    }

    .story-layout {
      grid-template-columns: 1.2fr 0.8fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: stretch;
    }

    .story-portrait {
      min-height: 30rem;
    }
  }

  @media (min-width: 720px) {
    .principle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principle + .principle {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .skill-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
