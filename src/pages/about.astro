---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SecurityStrip from '../components/SecurityStrip.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { site } from '../data/site.js';
import { experience } from '../data/experience.js';

const stats = [
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
];
---

<BaseLayout title="About" description={site.about.lead}>
  <div class="container page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-intro">
        <SectionHeading as="h1" eyebrow="About" title="Design, code and security in one toolkit" id="about-title" />
        <p class="hero-note">{site.about.lead}</p>

        <ul class="stats">
          {stats.map((stat) => (
            <li class="panel">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <ProfileCard />
    </section>

    <section class="block" aria-labelledby="story-title">
      <div class="story-layout">
        <div class="story-side">
          <SectionHeading eyebrow="Background" title="A short story" id="story-title" index="01" />
          <figure class="story-photo">
            <picture>
              <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
              <img
                src="/niroj.png?v=20261122b"
                width="256"
                height="256"
                loading="lazy"
                alt="Portrait of Niroj Pyakurel"
              />
            </picture>
            <figcaption>
              <strong>{site.name}</strong>
              <span>Design · Web · Security</span>
            </figcaption>
          </figure>
        </div>
        <div class="prose story">
          <p class="lead">{site.about.lead}</p>
          {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>{site.about.closing}</p>
        </div>
      </div>
    </section>

    <section class="block portrait-section" aria-labelledby="portrait-title">
      <div class="portrait-feature panel">
        <div class="portrait-frame">
          <span class="portrait-index" aria-hidden="true">NP / 01</span>
          <div class="portrait-halo" aria-hidden="true"></div>
          <picture>
            <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
            <img
              class="portrait-photo"
              src="/niroj.png?v=20261122b"
              width="512"
              height="512"
              loading="lazy"
              alt="Portrait of Niroj Pyakurel"
            />
          </picture>
          <span class="portrait-caption">Niroj Pyakurel · {site.location}</span>
        </div>

        <div class="portrait-copy">
          <SectionHeading eyebrow="The person" title="Behind the pixels" id="portrait-title" index="—" />
          <p class="portrait-lead">
            A freelance designer and Computer Science student who likes work that is both useful and carefully made.
          </p>
          <ul class="portrait-facts">
            <li>
              <span class="fact-label">Based in</span>
              <strong>{site.location}</strong>
            </li>
            <li>
              <span class="fact-label">Focus</span>
              <strong>Design · Web · Security</strong>
            </li>
            <li>
              <span class="fact-label">Status</span>
              <strong>{site.availability}</strong>
            </li>
          </ul>
          <a class="portrait-cta" href="/contact/">Work with me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="skills-title">
      <SectionHeading eyebrow="Toolkit" title="Skills" id="skills-title" index="02">
        Grouped the way I actually use them — language, systems, security and the people side.
      </SectionHeading>
      <div class="skill-grid">
        {site.skills.map((group) => (
          <article class="skill-group panel">
            <div class="skill-head">
              <span class="skill-count">{String(group.items.length).padStart(2, '0')}</span>
              <h3>{group.label}</h3>
            </div>
            <ul class="chip-list">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="background-title">
      <SectionHeading eyebrow="Background" title="Education & certifications" id="background-title" index="03" />
      <div class="detail-grid">
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-5 9 5-9 5-9-5Z" />
                <path d="M7 11v5c0 1.5 2.2 3 5 3s5-1.5 5-3v-5" />
              </svg>
            </span>
            <h3>Education</h3>
          </div>
          <ul class="details">
            {site.education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span>{item.school}</span>
                <span class="muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5c0 4.5 2.8 8.4 7 10 4.2-1.6 7-5.5 7-10V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>
            <h3>Certifications</h3>
          </div>
          <ul class="details">
            {site.certifications.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.issuer}</span>
                <span class="muted">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="approach-title">
      <SectionHeading eyebrow="How I work" title="Clarity, consistency, teamwork" id="approach-title" index="04">
        Good work depends on knowing what matters, keeping it consistent, and communicating clearly while you do it.
      </SectionHeading>
      <SecurityStrip />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .about-hero {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .about-intro h1 {
    max-width: 18ch;
  }

  .hero-note {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .stats strong {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-link);
  }

  .stats span {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .block {
    margin-top: var(--space-section);
  }

  .story-layout {
    display: grid;
    gap: 2rem;
  }

  .story-side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .story-photo {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 50% 0%, var(--color-accent-soft), transparent 65%),
      var(--color-bg-deep);
  }

  .story-photo picture {
    display: contents;
  }

  .story-photo img {
    width: min(100%, 10rem);
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 0.5rem var(--color-accent-soft);
  }

  .story-photo figcaption {
    text-align: center;
  }

  .story-photo figcaption strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .story-photo figcaption span {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .story {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--color-surface);
  }

  .story .lead {
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .story p + p {
    margin-top: 1.25rem;
    color: var(--color-muted);
  }

  .portrait-feature {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 15%, var(--color-accent-soft), transparent 45%),
      radial-gradient(circle at 90% 90%, var(--color-teal-soft), transparent 50%),
      var(--color-surface);
  }

  .portrait-frame {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 20rem;
    padding: 2rem 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(160deg, rgb(110 231 183 / 0.1), transparent 55%),
      var(--color-bg-deep);
  }

  .portrait-frame::before,
  .portrait-frame::after {
    content: '';
    position: absolute;
    width: 2.5rem;
    height: 2.5rem;
    border-color: var(--color-accent);
    opacity: 0.65;
    pointer-events: none;
  }

  .portrait-frame::before {
    top: 0.85rem;
    left: 0.85rem;
    border-top: 2px solid;
    border-left: 2px solid;
    border-top-left-radius: 8px;
  }

  .portrait-frame::after {
    right: 0.85rem;
    bottom: 0.85rem;
    border-right: 2px solid;
    border-bottom: 2px solid;
    border-bottom-right-radius: 8px;
  }

  .portrait-index {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-link);
  }

  .portrait-halo {
    position: absolute;
    width: min(78%, 20rem);
    aspect-ratio: 1;
    border: 1px dashed var(--color-accent-line);
    border-radius: 50%;
    animation: portrait-spin 40s linear infinite;
  }

  .portrait-frame picture {
    display: contents;
  }

  .portrait-photo {
    position: relative;
    width: min(65%, 16rem);
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 0.55rem var(--color-accent-soft), var(--shadow-card);
  }

  .portrait-caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 2rem);
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-align: center;
  }

  .portrait-copy h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .portrait-lead {
    max-width: 42ch;
    margin-top: 1.25rem;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .portrait-facts {
    display: grid;
    gap: 0;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .portrait-facts li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .portrait-facts strong {
    font-size: 0.95rem;
    text-align: right;
  }

  .portrait-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--transition), background-color var(--transition);
  }

  .portrait-cta:hover {
    transform: translateY(-2px);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @keyframes portrait-spin {
    to { transform: rotate(360deg); }
  }

  .skill-grid,
  .detail-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .skill-group {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: none;
    transition: transform var(--transition), border-color var(--transition);
  }

  .skill-group:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-line);
  }

  .skill-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .skill-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .detail-panel {
    padding: 1.75rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .detail-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .detail-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .detail-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .details {
    padding: 0;
    list-style: none;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.1rem;
  }

  .details li + li {
    border-top: 1px solid var(--color-border);
  }

  .details span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    color: var(--color-link) !important;
  }

  @media (min-width: 900px) {
    .about-hero {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: center;
    }

    .story-layout {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: start;
    }

    .portrait-feature {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2rem, 5vw, 4.5rem);
    }

    .portrait-frame {
      min-height: 28rem;
    }
  }

  @media (min-width: 720px) {
    .skill-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
