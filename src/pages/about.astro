---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SecurityStrip from '../components/SecurityStrip.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { site } from '../data/site.js';
import { experience } from '../data/experience.js';

const stats = [
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
];
---

<BaseLayout title="About" description={site.about.lead}>
  <div class="container page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-intro">
        <SectionHeading as="h1" eyebrow="About" title="Design, code and security in one toolkit" id="about-title" />
        <p class="hero-note">{site.about.lead}</p>

        <ul class="stats">
          {stats.map((stat) => (
            <li class="panel">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <ProfileCard />
    </section>

    <section class="block story-section" aria-labelledby="story-title">
      <SectionHeading eyebrow="Background" title="A short story" id="story-title" index="01" />
      <div class="story-layout">
        <div class="prose story">
          <p class="lead">{site.about.lead}</p>
          {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>{site.about.closing}</p>
          <a class="story-link" href="/contact/">Let's talk about your project <span aria-hidden="true">→</span></a>
        </div>

        <figure class="story-portrait">
          <picture>
            <source srcset="/niroj-portrait.webp?v=20261122d" type="image/webp" />
            <img
              src="/niroj-portrait.png?v=20261122d"
              width="768"
              height="1024"
              loading="lazy"
              alt="Portrait of Niroj Pyakurel"
            />
          </picture>
          <span class="portrait-tag" aria-hidden="true">NP / 01</span>
          <figcaption>
            <span>Based in {site.location}</span>
            <strong>{site.name}</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="block" aria-labelledby="skills-title">
      <SectionHeading eyebrow="Toolkit" title="Skills" id="skills-title" index="02">
        Grouped the way I actually use them — language, systems, security and the people side.
      </SectionHeading>
      <div class="skill-grid">
        {site.skills.map((group) => (
          <article class="skill-group panel">
            <div class="skill-head">
              <span class="skill-count">{String(group.items.length).padStart(2, '0')}</span>
              <h3>{group.label}</h3>
            </div>
            <ul class="chip-list">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="background-title">
      <SectionHeading eyebrow="Background" title="Education & certifications" id="background-title" index="03" />
      <div class="detail-grid">
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-5 9 5-9 5-9-5Z" />
                <path d="M7 11v5c0 1.5 2.2 3 5 3s5-1.5 5-3v-5" />
              </svg>
            </span>
            <h3>Education</h3>
          </div>
          <ul class="details">
            {site.education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span>{item.school}</span>
                <span class="muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="detail-panel panel">
          <div class="detail-head">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5c0 4.5 2.8 8.4 7 10 4.2-1.6 7-5.5 7-10V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>
            <h3>Certifications</h3>
          </div>
          <ul class="details">
            {site.certifications.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.issuer}</span>
                <span class="muted">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="approach-title">
      <SectionHeading eyebrow="How I work" title="Clarity, consistency, teamwork" id="approach-title" index="04">
        Good work depends on knowing what matters, keeping it consistent, and communicating clearly while you do it.
      </SectionHeading>
      <SecurityStrip />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .about-hero {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .about-intro h1 {
    max-width: 18ch;
  }

  .hero-note {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .stats strong {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-link);
  }

  .stats span {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .block {
    margin-top: var(--space-section);
  }

  .story-layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    align-items: stretch;
  }

  .story {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--color-surface);
  }

  .story .lead {
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .story p + p {
    margin-top: 1.25rem;
    color: var(--color-muted);
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-accent-line);
    color: var(--color-link);
    font-weight: 700;
    text-decoration: none;
    transition: gap var(--transition), color var(--transition);
  }

  .story-link:hover {
    gap: 0.85rem;
    color: var(--color-accent);
  }

  .story-portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    min-height: 24rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-lg);
    background: var(--color-bg-deep);
    box-shadow: var(--shadow-card);
  }

  .story-portrait::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to bottom, transparent, rgb(4 15 19 / 0.92));
    pointer-events: none;
  }

  .story-portrait picture {
    display: contents;
  }

  .story-portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .story-portrait:hover img {
    transform: scale(1.04);
  }

  .portrait-tag {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 999px;
    background: rgb(7 21 26 / 0.72);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--color-link);
  }

  .story-portrait figcaption {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .story-portrait figcaption span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .story-portrait figcaption strong {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    letter-spacing: -0.03em;
  }

  .skill-grid,
  .detail-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .skill-group {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: none;
    transition: transform var(--transition), border-color var(--transition);
  }

  .skill-group:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-line);
  }

  .skill-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .skill-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .detail-panel {
    padding: 1.75rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .detail-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .detail-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .detail-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .details {
    padding: 0;
    list-style: none;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.1rem;
  }

  .details li + li {
    border-top: 1px solid var(--color-border);
  }

  .details span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    color: var(--color-link) !important;
  }

  @media (min-width: 900px) {
    .about-hero {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: center;
    }

    .story-layout {
      grid-template-columns: 1.2fr 0.8fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: stretch;
    }

    .story-portrait {
      min-height: 30rem;
    }
  }

  @media (min-width: 720px) {
    .skill-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
