---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.js';
import { socials } from '../data/socials.js';

const inquiryHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;

const iconFor = (label) => {
  if (label === 'Email') return 'mail';
  if (label === 'LinkedIn') return 'linkedin';
  return 'github';
};
---

<BaseLayout title="Contact" description={`Contact ${site.name} for design, web and security work in ${site.location}.`}>
  <div class="container page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div>
        <SectionHeading as="h1" eyebrow="Contact" title="Let's work together" id="contact-title" />
        <p class="intro">{site.availability}. Email is the fastest way to reach me; I'm based in {site.location} and happy to work remotely.</p>
        <a class="primary-cta" href={inquiryHref}>
          Start a project <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-callout panel">
        <div class="callout-top">
          <picture>
            <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
            <img
              class="callout-avatar"
              src="/niroj.png?v=20261122b"
              width="72"
              height="72"
              loading="lazy"
              alt=""
            />
          </picture>
          <div>
            <span class="status-dot" aria-hidden="true"></span>
            <p class="callout-label">Currently</p>
          </div>
        </div>
        <p class="callout-text">{site.availability}</p>
        <div class="callout-rule"></div>
        <p class="callout-meta">Kathmandu, Nepal · Remote friendly</p>
        <a class="callout-link" href={inquiryHref}>Send an email →</a>
      </div>
    </section>

    <section class="block" aria-labelledby="services-title">
      <SectionHeading eyebrow="Help" title="How I can help" id="services-title" index="01">
        Three ways I can make a project clearer, safer and better looking.
      </SectionHeading>
      <ul class="service-grid">
        {site.services.map((service) => (
          <li class="panel service-card">
            <span class="service-icon" aria-hidden="true">
              {service.icon === 'design' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 3 12l9 9 9-9-9-9Z" /><path d="M12 3v18" /><path d="m3 12 9-3 9 3" />
                </svg>
              )}
              {service.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 5 6v5c0 4.5 2.8 8.4 7 10 4.2-1.6 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {service.icon === 'code' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="m14 4-4 16" />
                </svg>
              )}
            </span>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="brief-title">
      <SectionHeading eyebrow="Quick brief" title="Tell me what you need" id="brief-title" index="02">
        A few lines is enough. This opens your email app with the details filled in — nothing is stored on this site.
      </SectionHeading>
      <form class="brief-form panel" id="brief-form" data-email={site.email}>
        <div class="form-row">
          <label>
            <span>Your name</span>
            <input name="name" type="text" autocomplete="name" placeholder="Your name" required />
          </label>
          <label>
            <span>Your email</span>
            <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          </label>
        </div>
        <label>
          <span>What is this about?</span>
          <select name="interest" required>
            {site.services.map((service) => <option value={service.title}>{service.title}</option>)}
            <option value="Something else">Something else</option>
          </select>
        </label>
        <label>
          <span>Project details</span>
          <textarea name="message" rows="5" placeholder="A short description, timeline and anything I should know." required></textarea>
        </label>
        <div class="form-footer">
          <p>Prefer plain email? <a href={inquiryHref}>{site.email}</a></p>
          <button class="primary-cta" type="submit">
            Open email draft <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </section>

    <section class="block" aria-labelledby="details-title">
      <SectionHeading eyebrow="Details" title="Where to find me" id="details-title" index="03" />
      <ul class="contact-cards">
        {socials.map((social) => (
          <li class="panel">
            <a href={social.href} rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <span class="card-icon" aria-hidden="true">
                {iconFor(social.label) === 'mail' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}
                {iconFor(social.label) === 'linkedin' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9v10" /><path d="M6 5.5v.01" />
                    <path d="M11 19v-6a3 3 0 0 1 6 0v6" /><path d="M11 9v10" />
                  </svg>
                )}
                {iconFor(social.label) === 'github' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-4 1.5-4-2-6-2.5" /><path d="M15 22v-4a4 4 0 0 0-1-3.2c3-.4 6-1.5 6-6.5A5 5 0 0 0 18.5 4 4.6 4.6 0 0 0 18.4.5S17 .1 15 1.5a12 12 0 0 0-6 0C7 .1 5.6.5 5.6.5A4.6 4.6 0 0 0 5.5 4 5 5 0 0 0 4 8.3c0 5 3 6.1 6 6.5A4 4 0 0 0 9 18v4" />
                  </svg>
                )}
              </span>
              <span class="card-body">
                <span class="card-label">{social.label}</span>
                <strong>{social.handle}</strong>
              </span>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
        <li class="panel location-card">
          <span class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <span class="card-body">
            <span class="card-label">Location</span>
            <strong>{site.location}</strong>
          </span>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector('#brief-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const interest = String(data.get('interest') || '').trim();
    const message = String(data.get('message') || '').trim();
    const subject = `${interest} inquiry — ${name}`;
    const body = [`Name: ${name}`, `Email: ${email}`, `Interested in: ${interest}`, '', message].join('\n');
    const to = form.dataset.email || '';
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .contact-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .contact-hero h1 {
    max-width: 14ch;
  }

  .intro {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .primary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.9rem 1.35rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--transition), background-color var(--transition);
  }

  .primary-cta:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-accent) 85%, white);
  }

  .contact-callout {
    padding: 2rem;
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 55%),
      var(--color-surface);
  }

  .callout-label {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .callout-text {
    margin-top: 0.5rem;
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .callout-rule {
    height: 1px;
    margin-block: 1.5rem;
    background: var(--color-border);
  }

  .callout-meta {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .callout-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .callout-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .callout-avatar {
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .callout-top picture {
    display: contents;
  }

  .callout-top .callout-label {
    margin-top: 0.35rem;
  }

  .service-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .service-card {
    padding: 1.6rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition), border-color var(--transition);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-line);
  }

  .service-icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .service-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .service-card h2 {
    font-size: 1.1rem;
  }

  .service-card p {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .brief-form {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background:
      radial-gradient(circle at 100% 0%, var(--color-teal-soft), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .brief-form label {
    display: grid;
    gap: 0.5rem;
  }

  .brief-form label > span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .brief-form input,
  .brief-form select,
  .brief-form textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-deep);
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .brief-form textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .brief-form input::placeholder,
  .brief-form textarea::placeholder {
    color: var(--color-muted);
    opacity: 0.75;
  }

  .brief-form input:focus,
  .brief-form select:focus,
  .brief-form textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
    outline: none;
  }

  .form-row {
    display: grid;
    gap: 1.25rem;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .form-footer p {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .form-footer a {
    color: var(--color-link);
  }

  .brief-form .primary-cta {
    margin-top: 0;
  }

  .block {
    margin-top: var(--space-section);
  }

  .contact-cards {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .contact-cards a,
  .location-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    height: 100%;
    padding: 1.35rem;
    text-decoration: none;
    transition: transform var(--transition), border-color var(--transition);
  }

  .contact-cards a:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-line);
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .card-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .card-body strong {
    color: var(--color-text);
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .card-arrow {
    margin-left: auto;
    color: var(--color-link);
  }

  @media (min-width: 900px) {
    .contact-hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  @media (min-width: 720px) {
    .contact-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .form-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
