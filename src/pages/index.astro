---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SecurityStrip from '../components/SecurityStrip.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import NoteCard from '../components/NoteCard.astro';
import { site } from '../data/site.js';

const inquiryHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
const byDate = (a, b) => b.data.date.getTime() - a.data.date.getTime();
const projects = (await getCollection('projects')).sort(byDate).slice(0, 2);
const notes = (await getCollection('writing')).sort(byDate).slice(0, 1);
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1 id="hero-title">{site.hero.headline}</h1>
      <p class="lede">{site.hero.lede}</p>

      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <div class="actions">
        <a class="button button-primary" href={inquiryHref}>
          Start a project <span aria-hidden="true">→</span>
        </a>
        <a class="button button-secondary" href="/projects/">
          See my work <span aria-hidden="true">↓</span>
        </a>
      </div>

      <a class="scroll-cue" href="#services">
        <span>Explore what I do</span>
        <span class="cue-track" aria-hidden="true"><span></span></span>
      </a>
    </div>
    <HeroVisual />
  </section>

  <section class="section container" id="services" aria-labelledby="services-title">
    <SectionHeading eyebrow="What I do" title="Services" id="services-title" index="01" />
    <div class="service-grid">
      {site.services.map((service, index) => (
        <ServiceCard {...service} index={index + 1} />
      ))}
    </div>
    <SecurityStrip />
  </section>

  <section class="section container" id="work" aria-labelledby="work-title">
    <SectionHeading eyebrow="Selected work" title="Things I have built" id="work-title" index="02" />
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          date={project.data.date}
          href={`/projects/${project.id}/`}
          featured={project.id === 'invoice-generator'}
        >
          {project.id === 'invoice-generator' && <ProjectPreview slot="media" />}
        </ProjectCard>
      ))}
    </div>
    <a class="more-link" href="/projects/">All projects →</a>
  </section>

  {notes.length > 0 && (
    <section class="section container" id="notes" aria-labelledby="notes-title">
      <SectionHeading eyebrow="Writing" title="Latest note" id="notes-title" index="03" />
      <div class="note-wrap">
        {notes.map((note) => (
          <NoteCard
            title={note.data.title}
            description={note.data.description}
            tags={note.data.tags}
            date={note.data.date}
            href={`/writing/${note.id}/`}
          />
        ))}
      </div>
      <a class="more-link" href="/writing/">All notes →</a>
    </section>
  )}

  <section class="section container" aria-labelledby="cta-title">
    <div class="cta panel">
      <div>
        <p class="eyebrow">Have something in mind?</p>
        <h2 id="cta-title">Let's make it happen.</h2>
        <p>Design, web work or a practical security pass — tell me what you need.</p>
      </div>
      <a class="button button-primary" href={inquiryHref}>Start a project →</a>
    </div>
  </section>
</BaseLayout>

<script>
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.section').forEach((section) => {
      section.querySelectorAll(':scope > *').forEach((child) => child.classList.add('reveal'));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
    );

    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
  }
</script>

<style>
  :global(.reveal) {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(3px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.reveal:nth-child(2)) { transition-delay: 70ms; }
  :global(.reveal:nth-child(3)) { transition-delay: 140ms; }
  :global(.reveal:nth-child(4)) { transition-delay: 210ms; }

  :global(.reveal.in-view) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .hero-copy > * {
    animation: hero-rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-copy > :nth-child(2) { animation-delay: 80ms; }
  .hero-copy > :nth-child(3) { animation-delay: 160ms; }
  .hero-copy > :nth-child(4) { animation-delay: 240ms; }
  .hero-copy > :nth-child(5) { animation-delay: 320ms; }
  .hero-copy > :nth-child(6) { animation-delay: 400ms; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .hero {
    display: grid;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 7vw, 5rem);
  }

  .hero-copy .eyebrow {
    color: var(--color-link);
  }

  h1 {
    max-width: 18ch;
    margin-top: 1.25rem;
  }

  .lede {
    margin-top: 1.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .scroll-cue:hover {
    color: var(--color-link);
  }

  .cue-track {
    position: relative;
    width: 3.5rem;
    height: 1px;
    overflow: hidden;
    background: var(--color-border);
  }

  .cue-track > span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: var(--color-accent);
    animation: cue-slide 2.6s ease-in-out infinite;
  }

  @keyframes cue-slide {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(280%); }
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.3rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform var(--transition), background-color var(--transition), border-color var(--transition), color var(--transition);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .button-primary:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, white);
  }

  .button-secondary {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface);
  }

  .button-secondary:hover {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .service-grid,
  .project-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .more-link {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .more-link:hover {
    color: var(--color-link);
  }

  .note-wrap {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
    padding: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 90% 20%, var(--color-accent-soft), transparent 55%),
      var(--color-surface);
  }

  .cta h2 {
    margin-top: 0.85rem;
  }

  .cta p:not(.eyebrow) {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  @media (min-width: 720px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
