---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import Tag from '../components/Tag.astro';
import { site } from '../data/site.js';
import { experience } from '../data/experience.js';

const inquiryHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
const byDate = (a, b) => b.data.date.getTime() - a.data.date.getTime();
const projects = (await getCollection('projects')).sort(byDate).slice(0, 3);
const notes = (await getCollection('writing')).sort(byDate).slice(0, 1);

const stats = [
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
];

const serviceFor = (icon) => site.services.find((service) => service.icon === icon);
const designService = serviceFor('design');
const codeService = serviceFor('code');
const securityService = serviceFor('shield');

const languages = site.skills.find((group) => group.label === 'Languages')?.items.slice(0, 3) || [];

const disciplineHints = {
  design: site.designTools.join(' · '),
  web: languages.join(' · '),
  security: site.security.tools.slice(0, 3).join(' · '),
};

const designOrder = ['Figma', 'Photoshop', 'Canva'];
const securityOrder = ['Burp Suite', 'Nmap', 'Wireshark', 'Nessus'];
const marqueeTools = [
  ...designOrder.map((name) => site.designTools.find((tool) => tool === name)).filter(Boolean),
  ...securityOrder.map((name) => site.security.tools.find((tool) => tool === name)).filter(Boolean),
];

const codeLines = [
  { text: 'const craft = {', tone: 'kw' },
  { text: `  design: '${designService?.title ?? 'Design'}',`, tone: 'str' },
  { text: `  web: '${codeService?.title ?? 'Web'}',`, tone: 'str' },
  { text: '  security: true', tone: 'bool' },
  { text: '};', tone: 'kw' },
];

const skillSample = site.skills.slice(0, 4);

const commands = {
  whoami: [
    { text: `${site.name} — ${site.hero.eyebrow.toLowerCase()}`, tone: 'ok' },
    { text: `focus: ${site.services.map((service) => service.title).join(' / ')}`, tone: 'value' },
    { text: `tools: ${[...site.designTools, ...site.security.tools].join(', ')}`, tone: 'muted' },
    { text: `status: ${site.availability}`, tone: 'ok' },
  ],
  'ls projects/': [
    { text: `${projects.length} case study available`, tone: 'muted' },
    ...projects.map((project) => ({
      text: `drwxr-xr-x  ${project.id}/  ${project.data.title}`,
      tone: 'file',
    })),
    { text: "run 'open projects/' to browse the full index", tone: 'hint' },
  ],
  'cat skills.json': [
    { text: '{', tone: 'punc' },
    ...skillSample.map((group, index) => ({
      text: `  "${group.label}": [${group.items.map((item) => `"${item}"`).join(', ')}]${
        index < skillSample.length - 1 ? ',' : ''
      }`,
      tone: 'str',
    })),
    { text: '}', tone: 'punc' },
    { text: `// ${site.skills.length} groups in total`, tone: 'comment' },
  ],
  'scan --security': [
    { text: `target: ${site.location} · remote`, tone: 'muted' },
    ...site.security.tools.map((tool) => ({ text: `  ✓ ${tool}  ready`, tone: 'ok' })),
    { text: site.security.note, tone: 'hint' },
    { text: site.security.certifications[0], tone: 'comment' },
  ],
  contact: [
    { text: `email: ${site.email}`, tone: 'ok' },
    { text: "run 'open mail' to start a project", tone: 'hint' },
  ],
  help: [
    { text: 'available commands:', tone: 'ok' },
    { text: '  whoami            profile snapshot', tone: 'muted' },
    { text: '  ls projects/      case studies', tone: 'muted' },
    { text: '  cat skills.json   skill groups', tone: 'muted' },
    { text: '  scan --security   toolchain check', tone: 'muted' },
    { text: '  contact           email address', tone: 'muted' },
    { text: '  open projects/    visit /projects/', tone: 'muted' },
    { text: '  clear             wipe the screen', tone: 'muted' },
  ],
};

const formatNoteDate = (date) =>
  new Date(date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout>
  <div class="home" data-home>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">{site.hero.eyebrow}</p>

        <p class="status-pill">
          <span class="live-dot" aria-hidden="true"></span>
          {site.availability}
          <span class="status-divider" aria-hidden="true">/</span>
          {site.location}
        </p>

        <h1 id="hero-title" class="hero-title">
          <span class="hero-word" data-discipline="design" style="--i: 0" tabindex="0">Design.</span>
          <span class="hero-word" data-discipline="web" style="--i: 1" tabindex="0">Build.</span>
          <span class="hero-word hero-word-accent" data-discipline="security" style="--i: 2" tabindex="0">Secure.</span>
        </h1>

        <p class="hero-hint" data-hero-hint aria-live="polite">hover a word to peek</p>
        <script type="application/json" data-discipline-hints set:html={JSON.stringify(disciplineHints)}></script>

        <p class="lede">{site.hero.lede}</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href={inquiryHref} data-magnetic>
            <span>Start a project</span><span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/projects/" data-magnetic>
            <span>View work</span><span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="terminal-shell">
        <div
          class="terminal-card"
          data-terminal
          data-commands={JSON.stringify(commands)}
          data-mail-href={inquiryHref}
        >
          <div class="term-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="term-title">niroj@kathmandu:~</span>
            <span class="term-live"><span class="live-dot" aria-hidden="true"></span>live</span>
          </div>

          <div class="term-body">
            <div class="term-history" data-term-output aria-live="polite" aria-label="Terminal output">
              <div class="term-line">
                <span class="term-prompt">guest@niroj:~$</span>
                <span class="term-text tone-hint">Welcome. Try a command below.</span>
              </div>
            </div>

            <form class="term-form" data-term-form>
              <label class="sr-only" for="term-command">Terminal command</label>
              <span class="term-prompt" aria-hidden="true">guest@niroj:~$</span>
              <input
                id="term-command"
                data-term-input
                type="text"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                maxlength="48"
                placeholder="whoami"
              />
              <button type="submit" aria-label="Run command">↵</button>
            </form>

            <div class="term-chips" role="group" aria-label="Try a command">
              <button type="button" class="term-chip" data-command="whoami">whoami</button>
              <button type="button" class="term-chip" data-command="ls projects/">ls projects/</button>
              <button type="button" class="term-chip" data-command="cat skills.json">cat skills.json</button>
              <button type="button" class="term-chip" data-command="scan --security">scan --security</button>
            </div>
          </div>
        </div>
      </div>

      <div class="metrics" role="list" aria-label="At a glance">
        {stats.map((stat) => (
          <div class="metric" role="listitem">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section container" id="services" aria-labelledby="services-title">
      <header class="section-head section-head--split">
        <div>
          <p class="section-kicker">// 01 — what I do</p>
          <h2 id="services-title">Three ways I help.</h2>
        </div>
        <p>Design, code and security working together — not three separate checkboxes.</p>
      </header>

      <div class="bento">
        <article class="pillar pillar-design" data-tilt>
          <div class="pillar-bar">
            <span>01</span>
            <span>UI/UX &amp; Brand Design</span>
          </div>
          <div class="pillar-content">
            <h3>UI/UX &amp; Brand Design</h3>
            <p>{designService?.description}</p>
          </div>
          <div class="figma-mini" aria-hidden="true">
            <div class="mini-head"><span>layers</span><span>03</span></div>
            <ul>
              <li class="is-selected"><i class="swatch swatch-mint"></i><span>Hero / cover</span></li>
              <li><i class="swatch swatch-ink"></i><span>Brand kit</span></li>
              <li><i class="swatch swatch-amber"></i><span>Campaign set</span></li>
            </ul>
            <div class="mini-foot">{site.designTools.join(' · ')}</div>
          </div>
        </article>

        <article class="pillar pillar-code" data-tilt>
          <div class="pillar-bar">
            <span>02</span>
            <span>Full-Stack Web Development</span>
          </div>
          <div class="pillar-content">
            <h3>Full-Stack Web Development</h3>
            <p>{codeService?.description}</p>
          </div>
          <div class="code-wrap" aria-hidden="true">
            <pre class="code-mini"><code>{codeLines.map((line) => (
              <span class={`code-line tone-${line.tone}`}>{line.text}</span>
            ))}</code></pre>
            <div class="code-status"><span>✓</span> {languages.join(' / ')}</div>
          </div>
        </article>

        <article class="pillar pillar-security" data-tilt>
          <div class="pillar-bar">
            <span>03</span>
            <span>Practical Security Audits</span>
          </div>
          <div class="pillar-content">
            <h3>Practical Security Audits</h3>
            <p>{securityService?.description}</p>
          </div>
          <div class="scan-mini" aria-hidden="true">
            <div class="scan-head"><span class="scan-light"></span> toolchain check</div>
            <ul>
              {site.security.tools.map((tool) => (
                <li><span class="check">✓</span>{tool}</li>
              ))}
            </ul>
            <div class="scan-foot">{site.security.label} · {site.location}</div>
          </div>
        </article>
      </div>
    </section>

    <section class="section container" id="work" aria-labelledby="work-title">
      <header class="section-head section-head--split">
        <div>
          <p class="section-kicker">// 02 — featured work</p>
          <h2 id="work-title">Built, tested, shipped.</h2>
        </div>
        <p>Real constraints, real deliverables. Every project gets a plain-language security note.</p>
      </header>

      <div class="spotlight">
        {projects.map((project, index) => (
          <article class="spotlight-card">
            <a class="spotlight-preview" href={`/projects/${project.id}/`} aria-label={`Open ${project.data.title} case study`}>
              <ProjectPreview />
            </a>

            <div class="spotlight-copy">
              <div class="work-meta">
                <span class="work-index">0{index + 1}</span>
                <span>{project.data.date.getFullYear()} · {project.data.stack?.join(' / ') || 'Project'}</span>
              </div>

              <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
              <p class="work-description">{project.data.description}</p>

              <div class="problem-impact">
                <div>
                  <span>PROBLEM</span>
                  <p>Manual billing, repeated fields and arithmetic.</p>
                </div>
                <span class="flow-arrow" aria-hidden="true">→</span>
                <div>
                  <span>IMPACT</span>
                  <p>One-click invoices with automatic tax and .docx export.</p>
                </div>
              </div>

              <ul class="chip-list work-tags">
                {project.data.stack?.map((tool) => <li class="chip chip-accent">{tool}</li>)}
                {project.data.tags.map((tag) => <li><Tag label={tag} /></li>)}
              </ul>

              {project.data.securityNotes && (
                <p class="work-security">
                  <strong>SECURITY NOTE</strong>
                  {project.data.securityNotes}
                </p>
              )}

              <a class="text-link" href={`/projects/${project.id}/`}>open case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}

        <a class="spotlight-next" href={inquiryHref}>
          <span class="next-index">0{projects.length + 1}</span>
          <span class="section-kicker">next case study</span>
          <h3>Your project could be here.</h3>
          <p>Tell me what needs design, code or a security pass — I'll take it from there.</p>
          <span class="next-arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <a class="text-link work-all" href="/projects/">all projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="strip-section" aria-label="Toolchain and availability">
      <div class="container">
        <div class="tool-strip">
          <div class="strip-head">
            <span class="live-dot" aria-hidden="true"></span>
            <div>
              <p class="section-kicker">toolchain check</p>
              <p>Design + security, ready to go.</p>
            </div>
          </div>

          <div class="marquee" aria-label={`Tools: ${marqueeTools.join(', ')}`}>
            <div class="marquee-track">
              {[0, 1].map((copy) => (
                <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {marqueeTools.map((tool, index) => (
                    <li class:list={['chip', index % 2 === 0 ? 'chip-accent' : 'chip']}>{tool}</li>
                  ))}
                </ul>
              ))}
            </div>
          </div>

          <div class="strip-location">
            <span>{site.location}</span>
            <span>remote · worldwide</span>
          </div>
        </div>
      </div>
    </section>

    {notes.length > 0 && (
      <section class="section container note-section" aria-labelledby="notes-title">
        <header class="section-head section-head--split">
          <div>
            <p class="section-kicker">// 03 — log</p>
            <h2 id="notes-title">Latest note.</h2>
          </div>
          <a class="text-link" href="/writing/">all notes <span aria-hidden="true">→</span></a>
        </header>

        <div class="note-row">
          {notes.map((note) => (
            <article class="note-card">
              <time datetime={note.data.date.toISOString()}>{formatNoteDate(note.data.date)}</time>
              <div>
                <h3><a href={`/writing/${note.id}/`}>{note.data.title}</a></h3>
                <p>{note.data.description}</p>
              </div>
              <a class="log-arrow" href={`/writing/${note.id}/`} aria-label={`Read ${note.data.title}`}>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="section container" aria-labelledby="cta-title">
      <div class="final-cta">
        <p class="section-kicker">// 04 — let's talk</p>
        <h2 id="cta-title">Have an idea that needs clean design and solid security?</h2>
        <p class="cta-copy">
          Have something in mind? Send a note and let's shape the first step together.
        </p>

        <div class="final-actions">
          <a class="btn btn-primary" href={inquiryHref} data-magnetic>
            <span>Start a project</span><span aria-hidden="true">→</span>
          </a>
          <button
            class="btn btn-ghost"
            type="button"
            data-magnetic
            data-copy-email
            data-email={site.email}
          >
            <span data-copy-label>Copy email</span><span aria-hidden="true">⧉</span>
          </button>
        </div>

        <p class="final-email">{site.email}</p>
        <div class="toast" data-toast role="status" aria-live="polite">Copied to clipboard</div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initHome } from '../scripts/home.js';

  initHome();
</script>

<style>
  .home {
    --cursor-x: 50vw;
    --cursor-y: 20vh;
    --cursor-opacity: 0.55;
    position: relative;
    isolation: isolate;
  }

  :global([data-theme='light']) .home {
    --cursor-opacity: 0.3;
  }

  .home::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 52px 52px;
    background-position: calc(var(--cursor-x) * -0.012) calc(var(--cursor-y) * -0.012);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
  }

  .home::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      340px circle at var(--cursor-x) var(--cursor-y),
      color-mix(in srgb, var(--color-accent) 16%, transparent),
      transparent 72%
    );
    opacity: var(--cursor-opacity);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-kicker,
  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 999px;
    background: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text);
  }

  .status-divider {
    color: var(--color-muted);
  }

  .live-dot {
    display: inline-block;
    width: 0.48rem;
    height: 0.48rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
    animation: live-pulse 3.4s ease-in-out infinite;
  }

  .hero-title {
    margin-top: 1.35rem;
    font-size: clamp(3.1rem, 8.4vw, 6.3rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.14em;
    animation: word-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 110ms + 120ms);
    transition: color 300ms ease, text-shadow 300ms ease, transform 300ms ease;
  }

  .hero-word:last-child {
    margin-right: 0;
  }

  .hero-word-accent {
    color: var(--color-accent);
  }

  .hero-word:hover,
  .hero-word:focus-visible {
    color: var(--color-accent);
    text-shadow: 0 0 38px color-mix(in srgb, var(--color-accent) 38%, transparent);
    transform: translateY(-3px);
  }

  .hero-hint {
    min-height: 1.4em;
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-link);
  }

  .lede {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .btn {
    --mag-x: 0px;
    --mag-y: 0px;
    --btn-x: 50%;
    --btn-y: 50%;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transform: translate3d(var(--mag-x), var(--mag-y), 0);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 220ms ease,
      border-color 220ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      180px circle at var(--btn-x) var(--btn-y),
      color-mix(in srgb, var(--color-accent) 45%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .btn:hover::after {
    opacity: 0.55;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    box-shadow: 0 14px 34px var(--color-accent-soft);
  }

  .btn-ghost {
    border-color: var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent-line);
    color: var(--color-link);
  }

  .terminal-shell {
    position: relative;
    min-width: 0;
  }

  .terminal-shell::before {
    content: '';
    position: absolute;
    inset: -18% -12% -14%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 58% 42%,
      color-mix(in srgb, var(--color-accent) 20%, transparent),
      transparent 68%
    );
    filter: blur(20px);
  }

  .terminal-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .terminal-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 60%);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .window-dots {
    display: flex;
    gap: 0.35rem;
  }

  .window-dots i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .window-dots i:first-child {
    background: var(--color-accent);
  }

  .term-title {
    color: var(--color-text);
  }

  .term-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    color: var(--color-link);
    font-size: 0.64rem;
