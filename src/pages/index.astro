  }

  .type-specimen strong { font-size: 0.6rem; }
  .type-specimen small { color: var(--panel-muted); font-size: 0.43rem; }

  .hex-palette {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .hex-palette span {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    color: var(--panel-muted);
    font-size: 0.42rem;
    white-space: nowrap;
  }

  .hex-palette i {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    background: var(--swatch);
  }

  .layer-timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .timeline-item {
    padding: 0.42rem 0.28rem;
    border: 1px solid var(--panel-line);
    border-radius: 8px;
    background: rgb(255 255 255 / 0.02);
    color: var(--panel-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }

  .timeline-item:hover {
    border-color: rgb(74 222 128 / 0.34);
    color: var(--panel-text);
  }

  .timeline-item.is-selected {
    border-color: rgb(74 222 128 / 0.55);
    background: rgb(74 222 128 / 0.12);
    color: var(--panel-accent);
  }

  /* Card 02 — IDE and live browser preview */
  .ide-body {
    display: flex;
    flex-direction: column;
    height: calc(100% - 2rem);
    min-height: 0;
    padding: 0.55rem;
  }

  .code-mini {
    flex: 1;
    min-height: 10.5rem;
    margin: 0;
    padding: 0.55rem 0.65rem;
    overflow: auto;
    color: var(--panel-text);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    line-height: 1.65;
    scrollbar-width: thin;
  }

  .code-line {
    display: flex;
    gap: 0.65rem;
    min-height: 1.05rem;
    white-space: pre;
  }

  .line-no {
    color: #44615f;
    user-select: none;
  }

  .tok-kw { color: #c792ea; }
  .tok-str { color: #a5e88a; }
  .tok-fn { color: #7dd3fc; }
  .tok-obj { color: #ffd580; }
  .tok-punc { color: #89a5a2; }
  .tok-tag { color: #67e8f9; }
  .tok-attr { color: #c4b5fd; }

  .browser-preview {
    flex: none;
    overflow: hidden;
    margin-top: 0.5rem;
    border: 1px solid var(--panel-line);
    border-radius: 9px;
    background: #08191b;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--panel-line);
    color: var(--panel-muted);
    font-size: 0.48rem;
  }

  .http-status {
    margin-left: auto;
    color: var(--panel-accent);
  }

  .browser-body {
    padding: 0.6rem;
  }

  .preview-nav {
    display: flex;
    justify-content: space-between;
    color: var(--panel-accent);
    font-size: 0.52rem;
  }

  .preview-headline {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .preview-placeholder {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .preview-placeholder i {
    flex: 1;
    height: 0.27rem;
    border-radius: 999px;
    background: #254047;
  }

  .preview-placeholder i:last-child { flex: 0.6; }

  .preview-status {
    display: inline-block;
    margin-top: 0.55rem;
    padding: 0.24rem 0.48rem;
    border: 1px solid rgb(74 222 128 / 0.28);
    border-radius: 999px;
    background: rgb(74 222 128 / 0.08);
    color: var(--panel-accent);
    font-size: 0.48rem;
  }

  /* Card 03 — Security audit terminal */
  .audit-panel .window-bar {
    border-bottom-color: rgb(74 222 128 / 0.2);
  }

  .audit-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin-left: auto;
    color: var(--panel-accent);
    font-size: 0.47rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .audit-ready i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--panel-accent);
    box-shadow: 0 0 0 3px rgb(74 222 128 / 0.12);
    animation: live-pulse 3s ease-in-out infinite;
  }

  .audit-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: calc(100% - 2rem);
    padding: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .audit-command,
  .audit-muted {
    margin: 0;
  }

  .audit-command { color: var(--panel-text); }
  .audit-command span { color: var(--panel-accent); }
  .audit-muted { color: #6f8c89; }

  .audit-checks {
    display: grid;
    gap: 0.35rem;
  }

  .audit-checks > div {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--panel-line);
    border-radius: 8px;
    background: rgb(255 255 255 / 0.02);
  }

  .check {
    grid-row: 1 / span 2;
    color: var(--panel-accent);
    font-weight: 700;
  }

  .audit-checks strong {
    color: var(--panel-text);
    font-size: 0.56rem;
  }

  .audit-checks small {
    grid-column: 2;
    color: #6f8c89;
    font-size: 0.44rem;
  }

  .check-state {
    grid-row: 1 / span 2;
    grid-column: 3;
    color: var(--panel-accent);
    font-size: 0.42rem;
  }

  .audit-results {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .audit-results span {
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    font-size: 0.48rem;
  }

  .result-pass {
    border: 1px solid rgb(74 222 128 / 0.3);
    background: rgb(74 222 128 / 0.12);
    color: var(--panel-accent);
  }

  .result-secure {
    border: 1px solid rgb(45 212 191 / 0.26);
    background: rgb(45 212 191 / 0.1);
    color: #5eead4;
  }

  .audit-progress {
    overflow: hidden;
    height: 0.3rem;
    margin-top: auto;
    border-radius: 999px;
    background: #20373a;
  }

  .audit-progress i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #4ade80, #2dd4bf);
    transform: scaleX(0.82);
    transform-origin: left center;
    animation: audit-progress 3.2s ease-in-out infinite alternate;
  }

  .tool-pill {
    margin-top: auto;
    padding: 0.48rem 0.65rem;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: #a9c1bd;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-align: center;
  }

  @keyframes audit-progress {
    from { transform: scaleX(0.62); }
    to { transform: scaleX(0.92); }
  }

  .spotlight {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .spotlight-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .spotlight-card:hover {
    border-color: var(--color-accent-line);
    box-shadow: var(--shadow-card);
  }

  .spotlight-preview {
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: radial-gradient(circle at 50% 20%, var(--color-accent-soft), transparent 60%), var(--color-bg-deep);
    text-decoration: none;
  }

  .spotlight-preview > * {
    width: 100%;
    max-width: 26rem;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .spotlight-card:hover .spotlight-preview > * {
    transform: scale(1.05) translateY(-4px);
  }

  .spotlight-copy {
    padding: clamp(1.6rem, 4vw, 2.5rem);
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .work-index {
    color: var(--color-accent);
    font-weight: 700;
  }

  .spotlight-copy h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .spotlight-copy h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .spotlight-copy h3 a:hover {
    color: var(--color-link);
  }

  .work-description {
    margin-top: 0.8rem;
    color: var(--color-muted);
  }

  .problem-impact {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .problem-impact span:not(.flow-arrow) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--color-link);
  }

  .problem-impact p {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .flow-arrow {
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .work-tags {
    margin-top: 1.35rem;
  }

  .work-security {
    margin-top: 1.35rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-accent-soft);
    font-size: 0.85rem;
  }

  .work-security strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.12em;
    color: var(--color-link);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-link);
    text-decoration: none;
  }

  .text-link span {
    transition: transform 200ms ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .work-all {
    margin-top: 1.75rem;
  }

  .spotlight-next {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 15rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px dashed var(--color-accent-line);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 240ms ease, transform 240ms ease;
  }

  .spotlight-next:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .next-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
  }

  .spotlight-next h3 {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
  }

  .spotlight-next p:not(.section-kicker) {
    max-width: 46ch;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .next-arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    color: var(--color-link);
    font-size: 1.4rem;
  }

  .strip-section {
    padding-block: 0 clamp(2rem, 5vw, 3.5rem);
  }

  .tool-strip {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .strip-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .strip-head p:last-child {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    gap: 0.5rem;
    padding-right: 0.5rem;
    list-style: none;
  }

  .marquee-group li {
    flex: none;
  }

  .strip-location {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .strip-location span + span::before {
    content: '·';
    margin-right: 0.6rem;
    color: var(--color-accent);
  }

  .note-section {
    padding-top: 0;
  }

  .note-row {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .note-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .note-card time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-link);
    white-space: nowrap;
  }

  .note-card h3 {
    font-size: 1.15rem;
  }

  .note-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .note-card h3 a:hover {
    color: var(--color-link);
  }

  .note-card p {
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .log-arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-link);
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .log-arrow:hover {
    transform: translateX(3px);
    border-color: var(--color-accent-line);
  }

  .final-cta {
    --cta-text: #f8fafc;
    --cta-muted: #a7c9bd;
    --cta-accent: #4ade80;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(2rem, 5.5vw, 4rem);
    border: 1px solid rgb(74 222 128 / 0.26);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 86% 8%, rgb(74 222 128 / 0.16), transparent 42%),
      radial-gradient(circle at 0% 100%, rgb(15 118 110 / 0.18), transparent 48%),
      linear-gradient(145deg, rgb(10 22 24 / 0.96), rgb(4 15 19 / 0.95));
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.34), inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 0 50px rgb(74 222 128 / 0.07);
    color: var(--cta-text);
    text-align: left;
  }

  .final-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(148 184 176 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 184 176 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(120deg, #000, transparent 72%);
    mask-image: linear-gradient(120deg, #000, transparent 72%);
  }

  .final-cta .section-kicker {
    color: var(--cta-accent);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
  }

  .final-cta h2 {
    max-width: 20ch;
    margin-top: 1rem;
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .cta-copy {
    max-width: 54ch;
    margin-top: 1.1rem;
    color: var(--cta-muted);
    font-size: clamp(0.92rem, 1.4vw, 1rem);
  }

  .cta-side {
    display: grid;
    gap: 1rem;
  }

  .email-wrap {
    position: relative;
  }

  .email-display {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(74 222 128 / 0.24);
    border-radius: 14px;
    background: rgb(4 15 19 / 0.62);
    color: var(--cta-text);
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.25vw, 0.92rem);
    text-align: left;
    cursor: pointer;
    transition: border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
  }

  .email-display:hover {
    border-color: var(--cta-accent);
    background: rgb(74 222 128 / 0.07);
    box-shadow: 0 0 0 3px rgb(74 222 128 / 0.1), 0 12px 28px rgb(0 0 0 / 0.25);
  }

  .email-icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: 50%;
    background: rgb(74 222 128 / 0.14);
    color: var(--cta-accent);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .email-address {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .email-copy-icon {
    margin-left: auto;
    color: var(--cta-accent);
    font-size: 1rem;
  }

  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .final-cta .btn-primary {
    background: #4ade80;
    color: #020617;
    font-weight: 600;
  }

  .final-cta .btn-primary:hover {
    background: #34d399;
    box-shadow: 0 14px 34px rgb(52 211 153 / 0.22);
  }

  .final-cta .btn-ghost {
    border-color: rgb(248 250 252 / 0.22);
    background: rgb(255 255 255 / 0.03);
    color: var(--cta-text);
  }

  .final-cta .btn-ghost:hover {
    border-color: rgb(74 222 128 / 0.6);
    background: rgb(74 222 128 / 0.08);
    color: var(--cta-accent);
  }

  .toast {
    position: absolute;
    right: 0.75rem;
    bottom: calc(100% + 0.5rem);
    padding: 0.35rem 0.65rem;
    border: 1px solid rgb(74 222 128 / 0.4);
    border-radius: 999px;
    background: #0b1e20;
    color: var(--cta-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .toast::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 1rem;
    border: 5px solid transparent;
    border-top-color: rgb(74 222 128 / 0.4);
  }

  .toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .cta-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @keyframes word-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes line-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes live-pulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--color-accent-soft); }
    50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-accent) 10%, transparent); }
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
      align-items: center;
    }

    .spotlight-card {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .tool-strip {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (min-width: 760px) {
    .section-head--split {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
    }

    .section-head--split > p:last-child {
      justify-self: end;
      text-align: right;
    }
  }

  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar-security {
      grid-column: 1 / -1;
    }

    .pillar {
      min-height: 31rem;
    }
  }

  @media (max-width: 760px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .pillar-security {
      grid-column: auto;
    }

    .pillar {
      min-height: auto;
    }

    .glass-panel {
      min-height: 27rem;
    }

    .spotlight-preview {
      min-height: 16rem;
    }
  }

  @media (max-width: 639px) {
