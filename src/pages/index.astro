---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import Tag from '../components/Tag.astro';
import { site } from '../data/site.js';
import { experience } from '../data/experience.js';

const inquiryHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
const byDate = (a, b) => b.data.date.getTime() - a.data.date.getTime();
const projects = (await getCollection('projects')).sort(byDate).slice(0, 3);
const notes = (await getCollection('writing')).sort(byDate).slice(0, 1);

const stats = [
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
];

const languages = site.skills.find((group) => group.label === 'Languages')?.items.slice(0, 3) || [];

const disciplineHints = {
  design: site.designTools.join(' · '),
  web: languages.join(' · '),
  security: site.security.tools.slice(0, 3).join(' · '),
};

const designOrder = ['Figma', 'Photoshop', 'Canva'];
const securityOrder = ['Burp Suite', 'Nmap', 'Wireshark', 'Nessus'];
const marqueeTools = [
  ...designOrder.map((name) => site.designTools.find((tool) => tool === name)).filter(Boolean),
  ...securityOrder.map((name) => site.security.tools.find((tool) => tool === name)).filter(Boolean),
];

const codeLines = [
  [
    { tone: 'kw', text: 'from ' },
    { tone: 'obj', text: 'flask' },
    { tone: 'kw', text: ' import ' },
    { tone: 'fn', text: 'Flask' },
  ],
  [
    { tone: 'obj', text: 'app' },
    { tone: 'punc', text: ' = ' },
    { tone: 'fn', text: 'Flask' },
    { tone: 'punc', text: '(' },
    { tone: 'obj', text: '__name__' },
    { tone: 'punc', text: ')' },
  ],
  [],
  [
    { tone: 'obj', text: '@app' },
    { tone: 'punc', text: '.' },
    { tone: 'fn', text: 'route' },
    { tone: 'punc', text: '(' },
    { tone: 'str', text: '"/"' },
    { tone: 'punc', text: ')' },
  ],
  [
    { tone: 'kw', text: 'def ' },
    { tone: 'fn', text: 'home' },
    { tone: 'punc', text: '():' },
  ],
  [
    { tone: 'punc', text: '    ' },
    { tone: 'kw', text: 'return ' },
    { tone: 'str', text: '"Hello, Niroj"' },
  ],
];

const designStack = ['Photoshop', 'Canva', 'Illustrator'];
const webStack = ['HTML', 'CSS', 'Python', 'JavaScript'];
const securityStack = ['Burp Suite', 'Nmap', 'Wireshark', 'Nessus'];

const skillSample = site.skills.slice(0, 4);

const commands = {
  whoami: [
    { text: `${site.name} — ${site.hero.eyebrow.toLowerCase()}`, tone: 'ok' },
    { text: `focus: ${site.services.map((service) => service.title).join(' / ')}`, tone: 'value' },
    { text: `tools: ${[...site.designTools, ...site.security.tools].join(', ')}`, tone: 'muted' },
    { text: `status: ${site.availability}`, tone: 'ok' },
  ],
  'ls projects/': [
    { text: `${projects.length} case study available`, tone: 'muted' },
    ...projects.map((project) => ({
      text: `drwxr-xr-x  ${project.id}/  ${project.data.title}`,
      tone: 'file',
    })),
    { text: "run 'open projects/' to browse the full index", tone: 'hint' },
  ],
  'cat skills.json': [
    { text: '{', tone: 'punc' },
    ...skillSample.map((group, index) => ({
      text: `  "${group.label}": [${group.items.map((item) => `"${item}"`).join(', ')}]${
        index < skillSample.length - 1 ? ',' : ''
      }`,
      tone: 'str',
    })),
    { text: '}', tone: 'punc' },
    { text: `// ${site.skills.length} groups in total`, tone: 'comment' },
  ],
  'scan --security': [
    { text: `target: ${site.location} · remote`, tone: 'muted' },
    ...site.security.tools.map((tool) => ({ text: `  ✓ ${tool}  ready`, tone: 'ok' })),
    { text: site.security.note, tone: 'hint' },
    { text: site.security.certifications[0], tone: 'comment' },
  ],
  contact: [
    { text: `email: ${site.email}`, tone: 'ok' },
    { text: "run 'open mail' to start a project", tone: 'hint' },
  ],
  help: [
    { text: 'available commands:', tone: 'ok' },
    { text: '  whoami            profile snapshot', tone: 'muted' },
    { text: '  ls projects/      case studies', tone: 'muted' },
    { text: '  cat skills.json   skill groups', tone: 'muted' },
    { text: '  scan --security   toolchain check', tone: 'muted' },
    { text: '  contact           email address', tone: 'muted' },
    { text: '  open projects/    visit /projects/', tone: 'muted' },
    { text: '  clear             wipe the screen', tone: 'muted' },
  ],
};

const formatNoteDate = (date) =>
  new Date(date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout>
  <div class="home" data-home>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">{site.hero.eyebrow}</p>

        <p class="status-pill">
          <span class="live-dot" aria-hidden="true"></span>
          <span class="status-full">
            {site.availability}
            <span class="status-divider" aria-hidden="true">/</span>
            {site.location}
          </span>
          <span class="status-short">Available for freelance · Kathmandu</span>
        </p>

        <h1 id="hero-title" class="hero-title">
          <span class="hero-word" data-discipline="design" style="--i: 0" tabindex="0">Design.</span>
          <span class="hero-word" data-discipline="web" style="--i: 1" tabindex="0">Build.</span>
          <span class="hero-word hero-word-accent" data-discipline="security" style="--i: 2" tabindex="0">Secure.</span>
        </h1>

        <p class="hero-hint" data-hero-hint aria-live="polite">hover a word to peek</p>
        <script type="application/json" data-discipline-hints set:html={JSON.stringify(disciplineHints)}></script>

        <p class="lede">{site.hero.lede}</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href={inquiryHref} data-magnetic>
            <span>Start a project</span><span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/projects/" data-magnetic>
            <span>View work</span><span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="terminal-shell">
        <div
          class="terminal-card"
          data-terminal
          data-commands={JSON.stringify(commands)}
          data-mail-href={inquiryHref}
        >
          <div class="term-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="term-title">niroj@kathmandu:~</span>
            <span class="term-live"><span class="live-dot" aria-hidden="true"></span>live</span>
          </div>

          <div class="term-body">
            <div class="term-history" data-term-output aria-live="polite" aria-label="Terminal output">
              <div class="term-line">
                <span class="term-prompt">guest@niroj:~$</span>
                <span class="term-text tone-hint">Welcome. Try a command below.</span>
              </div>
            </div>

            <form class="term-form" data-term-form>
              <label class="sr-only" for="term-command">Terminal command</label>
              <span class="term-prompt" aria-hidden="true">guest@niroj:~$</span>
              <input
                id="term-command"
                data-term-input
                type="text"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                maxlength="48"
                placeholder="whoami"
              />
              <button type="submit" aria-label="Run command">↵</button>
            </form>

            <div class="term-chips" role="group" aria-label="Try a command">
              <button type="button" class="term-chip" data-command="whoami">whoami</button>
              <button type="button" class="term-chip" data-command="ls projects/">ls projects/</button>
              <button type="button" class="term-chip" data-command="cat skills.json">cat skills.json</button>
              <button type="button" class="term-chip" data-command="scan --security">scan --security</button>
            </div>
          </div>
        </div>
      </div>

      <div class="metrics" role="list" aria-label="At a glance">
        {stats.map((stat) => (
          <div class="metric" role="listitem">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section container" id="services" aria-labelledby="services-title">
      <header class="section-head section-head--split">
        <div>
          <p class="section-kicker">// 01 — what I do</p>
          <h2 id="services-title">Three ways I help.</h2>
        </div>
        <p>Design, code and security working together — not three separate checkboxes.</p>
      </header>

      <div class="bento">
        <article class="pillar pillar-design" data-tilt>
          <div class="pillar-top">
            <span class="pillar-index">01</span>
            <div class="pillar-content">
              <h3>Brand &amp; Visual Design</h3>
              <p>Brand graphics, social campaigns, and visual assets crafted from real work in travel media and live television.</p>
            </div>
          </div>

          <div class="glass-panel artwork-panel">
            <div class="window-bar">
              <span class="window-dots panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-name">brand-identity.psd</span>
              <span class="window-meta">PSD</span>
            </div>

            <div class="artwork-body">
              <div class="artwork-frame">
                <div class="artwork-head">
                  <span class="ps-badge" aria-label="Adobe Photoshop">Ps</span>
                  <span class="artwork-file">Adobe Photoshop</span>
                </div>

                <div class="brand-lockup">
                  <span class="brand-mark">NP</span>
                  <div class="brand-type">
                    <strong>Brand Kit</strong>
                    <span>Visual identity</span>
                  </div>
                </div>

                <div class="palette-bar" role="img" aria-label="Brand palette: forest, mint, mist, ink">
                  <i style="--swatch: #0d7a5f" title="Forest #0D7A5F"></i>
                  <i style="--swatch: #4ade80" title="Mint #4ADE80"></i>
                  <i style="--swatch: #e8f3ee" title="Mist #E8F3EE"></i>
                  <i style="--swatch: #0b1f1d" title="Ink #0B1F1D"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="tool-pill">{designStack.join(' · ')}</div>
        </article>

        <article class="pillar pillar-code" data-tilt>
          <div class="pillar-top">
            <span class="pillar-index">02</span>
            <div class="pillar-content">
              <h3>Full-Stack Web Development</h3>
              <p>Clean HTML, CSS, and Python foundations built with performance and security in mind from the start.</p>
            </div>
          </div>

          <div class="glass-panel ide-panel">
            <div class="window-bar">
              <span class="window-dots panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-name">app.py</span>
              <span class="window-meta">PY</span>
            </div>

            <div class="code-body">
              <pre class="code-block"><code>{codeLines.map((segments) => (
                <span class="code-row">{segments.map((segment) => (
                  <span class={`tok-${segment.tone}`}>{segment.text}</span>
                ))}</span>
              ))}</code></pre>
            </div>
          </div>

          <div class="tool-pill">{webStack.join(' · ')}</div>
        </article>

        <article class="pillar pillar-security" data-tilt>
          <div class="pillar-top">
            <span class="pillar-index">03</span>
            <div class="pillar-content">
              <h3>Practical Security Audits</h3>
              <p>Practical vulnerability checks with Nmap, Burp Suite, and Wireshark — findings prioritized in plain language.</p>
            </div>
          </div>

          <div class="glass-panel audit-panel">
            <div class="window-bar">
              <span class="window-dots panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-name">audit-status.txt</span>
              <span class="window-meta">3 / 3</span>
            </div>

            <div class="audit-body">
              <ul class="audit-rows">
                <li>
                  <span class="check">[PASS]</span>
                  <span>Port &amp; Service Scan <em>— Nmap</em></span>
                </li>
                <li>
                  <span class="check">[PASS]</span>
                  <span>HTTP Traffic &amp; Auth <em>— Burp Suite</em></span>
                </li>
                <li>
                  <span class="check">[PASS]</span>
                  <span>Packet Inspection <em>— Wireshark</em></span>
                </li>
              </ul>
            </div>
          </div>

          <div class="tool-pill">{securityStack.join(' · ')}</div>
        </article>
      </div>
    </section>

    <section class="section container" id="work" aria-labelledby="work-title">
      <header class="section-head section-head--split">
        <div>
          <p class="section-kicker">// 02 — featured work</p>
          <h2 id="work-title">Built, tested, shipped.</h2>
        </div>
        <p>Real constraints, real deliverables. Every project gets a plain-language security note.</p>
      </header>

      <div class="spotlight">
        {projects.map((project, index) => (
          <article class="spotlight-card">
            <a class="spotlight-preview" href={`/projects/${project.id}/`} aria-label={`Open ${project.data.title} case study`}>
              <ProjectPreview />
            </a>

            <div class="spotlight-copy">
              <div class="work-meta">
                <span class="work-index">0{index + 1}</span>
                <span>{project.data.date.getFullYear()} · {project.data.stack?.join(' / ') || 'Project'}</span>
              </div>

              <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
              <p class="work-description">{project.data.description}</p>

              <div class="problem-impact">
                <div>
                  <span>PROBLEM</span>
                  <p>Manual billing, repeated fields and arithmetic.</p>
                </div>
                <span class="flow-arrow" aria-hidden="true">→</span>
                <div>
                  <span>IMPACT</span>
                  <p>One-click invoices with automatic tax and .docx export.</p>
                </div>
              </div>

              <ul class="chip-list work-tags">
                {project.data.stack?.map((tool) => <li class="chip chip-accent">{tool}</li>)}
                {project.data.tags.map((tag) => <li><Tag label={tag} /></li>)}
              </ul>

              {project.data.securityNotes && (
                <p class="work-security">
                  <strong>SECURITY NOTE</strong>
                  {project.data.securityNotes}
                </p>
              )}

              <a class="text-link" href={`/projects/${project.id}/`}>open case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}

        <a class="spotlight-next" href={inquiryHref}>
          <span class="next-index">0{projects.length + 1}</span>
          <span class="section-kicker">next case study</span>
          <h3>Your project could be here.</h3>
          <p>Tell me what needs design, code or a security pass — I'll take it from there.</p>
          <span class="next-arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <a class="text-link work-all" href="/projects/">all projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="strip-section" aria-label="Toolchain and availability">
      <div class="container">
        <div class="tool-strip">
          <div class="strip-head">
            <span class="live-dot" aria-hidden="true"></span>
            <div>
              <p class="section-kicker">toolchain check</p>
              <p>Design + security, ready to go.</p>
            </div>
          </div>

          <div class="marquee" aria-label={`Tools: ${marqueeTools.join(', ')}`}>
            <div class="marquee-track">
              {[0, 1].map((copy) => (
                <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {marqueeTools.map((tool, index) => (
                    <li class:list={['chip', index % 2 === 0 ? 'chip-accent' : 'chip']}>{tool}</li>
                  ))}
                </ul>
              ))}
            </div>
          </div>

          <div class="strip-location">
            <span>{site.location}</span>
            <span>remote · worldwide</span>
          </div>
        </div>
      </div>
    </section>

    {notes.length > 0 && (
      <section class="section container note-section" aria-labelledby="notes-title">
        <header class="section-head section-head--split">
          <div>
            <p class="section-kicker">// 03 — log</p>
            <h2 id="notes-title">Latest note.</h2>
          </div>
          <a class="text-link" href="/writing/">all notes <span aria-hidden="true">→</span></a>
        </header>

        <div class="note-row">
          {notes.map((note) => (
            <article class="note-card">
              <time datetime={note.data.date.toISOString()}>{formatNoteDate(note.data.date)}</time>
              <div>
                <h3><a href={`/writing/${note.id}/`}>{note.data.title}</a></h3>
                <p>{note.data.description}</p>
              </div>
              <a class="log-arrow" href={`/writing/${note.id}/`} aria-label={`Read ${note.data.title}`}>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="section container" aria-labelledby="cta-title">
      <div class="final-cta">
        <p class="section-kicker">// 04 — let's talk</p>

        <div class="cta-grid">
          <div class="cta-copy-wrap">
            <h2 id="cta-title">Have a project in mind? Let's build something exceptional.</h2>
            <p class="cta-copy">
              Available for freelance design, full-stack development, and security audits — reach out to discuss your goals.
            </p>
          </div>

          <div class="cta-side">
            <div class="email-wrap">
              <div class="email-display">
                <span class="email-icon" aria-hidden="true">@</span>
                <span class="email-address">{site.email}</span>
              </div>
              <div class="toast" data-toast role="status" aria-live="polite">Copied!</div>
            </div>

            <div class="final-actions">
              <a class="btn btn-primary" href={inquiryHref} data-magnetic>
                <span>Start a project</span><span aria-hidden="true">→</span>
              </a>
              <button
                class="btn btn-ghost"
                type="button"
                data-magnetic
                data-copy-email
                data-email={site.email}
              >
                <span data-copy-label>Copy Email</span><span aria-hidden="true">⧉</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initHome } from '../scripts/home.js';

  initHome();
</script>

<style>
  .home {
    --cursor-x: 50vw;
    --cursor-y: 20vh;
    --cursor-opacity: 0.55;
    position: relative;
    isolation: isolate;
  }

  :global([data-theme='light']) .home {
    --cursor-opacity: 0.3;
  }

  .home::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 52px 52px;
    background-position: calc(var(--cursor-x) * -0.012) calc(var(--cursor-y) * -0.012);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
  }

  .home::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      340px circle at var(--cursor-x) var(--cursor-y),
      color-mix(in srgb, var(--color-accent) 16%, transparent),
      transparent 72%
    );
    opacity: var(--cursor-opacity);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-kicker,
  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    margin-top: 1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 999px;
    background: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text);
    white-space: nowrap;
  }

  .status-full,
  .status-short {
    white-space: nowrap;
  }

  .status-short {
    display: none;
  }

  .status-divider {
    color: var(--color-muted);
  }

  .live-dot {
    display: inline-block;
    width: 0.48rem;
    height: 0.48rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
    animation: live-pulse 3.4s ease-in-out infinite;
  }

  .hero-title {
    margin-top: 1.35rem;
    font-size: clamp(3.1rem, 8.4vw, 6.3rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .hero-word {
    --word-hover: var(--color-accent);
    --word-glow: color-mix(in srgb, var(--color-accent) 38%, transparent);
    display: inline-block;
    margin-right: 0.14em;
    animation: word-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 110ms + 120ms);
    transition: color 300ms ease, text-shadow 300ms ease, transform 300ms ease;
  }

  .hero-word:last-child {
    margin-right: 0;
  }

  .hero-word-accent {
    color: var(--color-accent);
  }

  .hero-word:hover,
  .hero-word:focus-visible {
    color: var(--word-hover);
    text-shadow: 0 0 38px var(--word-glow);
    transform: translateY(-3px);
  }

  :global([data-theme='light']) .hero-word[data-discipline='design'] {
    --word-hover: #0d7a5f;
    --word-glow: rgb(13 122 95 / 0.28);
  }

  :global([data-theme='light']) .hero-word[data-discipline='web'] {
    --word-hover: #0f766e;
    --word-glow: rgb(15 118 110 / 0.28);
  }

  :global([data-theme='light']) .hero-word[data-discipline='security'] {
    --word-hover: #064e3b;
    --word-glow: rgb(6 78 59 / 0.28);
  }

  .hero-hint {
    min-height: 1.4em;
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-link);
  }

  .lede {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .btn {
    --mag-x: 0px;
    --mag-y: 0px;
    --btn-x: 50%;
    --btn-y: 50%;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transform: translate3d(var(--mag-x), var(--mag-y), 0);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 220ms ease,
      border-color 220ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      180px circle at var(--btn-x) var(--btn-y),
      color-mix(in srgb, var(--color-accent) 45%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .btn:hover::after {
    opacity: 0.55;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    box-shadow: 0 14px 34px var(--color-accent-soft);
  }

  .btn-ghost {
    border-color: var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent-line);
    color: var(--color-link);
  }

  .terminal-shell {
    position: relative;
    min-width: 0;
  }

  .terminal-shell::before {
    content: '';
    position: absolute;
    inset: -18% -12% -14%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 58% 42%,
      color-mix(in srgb, var(--color-accent) 20%, transparent),
      transparent 68%
    );
    filter: blur(20px);
  }

  .terminal-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .terminal-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 60%);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .window-dots {
    display: flex;
    gap: 0.35rem;
  }

  .window-dots i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .window-dots i:first-child {
    background: var(--color-accent);
  }

  .term-title {
    color: var(--color-text);
  }

  .term-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    color: var(--color-link);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .term-body {
    padding: 1.1rem 1.2rem 1.25rem;
    background:
      repeating-linear-gradient(to bottom, transparent 0 1.7rem, var(--grid-line) 1.7rem 1.71rem),
      var(--color-bg-deep);
  }

  .term-history {
    min-height: 12.5rem;
    max-height: 15.5rem;
    overflow-y: auto;
    scrollbar-width: thin;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.75;
  }

  .term-line {
    display: flex;
    gap: 0.55rem;
    animation: line-in 280ms ease both;
  }

  .term-line--output {
    padding-left: 0.4rem;
  }

  .term-prompt {
    flex: none;
    color: var(--color-accent);
    font-weight: 700;
  }

  .term-text {
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .tone-ok { color: var(--color-accent); }
  .tone-file { color: var(--color-link); }
  .tone-value { color: var(--color-text); }
  .tone-str { color: var(--color-accent-2); }
  .tone-muted { color: var(--color-muted); }
  .tone-hint { color: var(--color-link); }
  .tone-comment { color: var(--color-muted); opacity: 0.8; }
  .tone-punc,
  .tone-kw { color: var(--color-text); }
  .tone-bool { color: var(--color-accent-2); }

  .term-form {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.8rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
  }

  .term-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.78rem;
    caret-color: var(--color-accent);
  }

  .term-form input::placeholder {
    color: var(--color-muted);
  }

  .term-form button {
    width: 2rem;
    height: 2rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .term-form button:hover {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .term-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .term-chip {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }

  .term-chip:hover {
    border-color: var(--color-accent-line);
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .metrics {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .metric {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .metric strong {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .metric span {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .section-head {
    display: grid;
    gap: 0.9rem;
    max-width: 70ch;
  }

  .section-head h2 {
    margin-top: 0.65rem;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
  }

  .section-head > p:last-child {
    color: var(--color-muted);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
    align-items: stretch;
  }

  .pillar {
    --rx: 0deg;
    --ry: 0deg;
    --tilt-x: 50%;
    --tilt-y: 50%;
    --panel-surface: linear-gradient(155deg, #0e1c1e, #0b1516);
    --panel-inner: #0e1c1e;
    --panel-canvas: #0a181a;
    --panel-bar: rgb(255 255 255 / 0.025);
    --panel-highlight: rgb(255 255 255 / 0.035);
    --panel-text: #e8f4f0;
    --panel-muted: #8fa9a5;
    --panel-line: rgb(148 184 176 / 0.16);
    --panel-accent: #4ade80;
    --panel-accent-soft: rgb(74 222 128 / 0.1);
    --panel-glow: rgb(74 222 128 / 0.12);
    --panel-shadow: 0 18px 44px rgb(0 0 0 / 0.26), inset 0 1px 0 rgb(255 255 255 / 0.035);
    --panel-hover-shadow: 0 24px 60px rgb(0 0 0 / 0.32), 0 0 32px rgb(74 222 128 / 0.1);
    --code-kw: #c792ea;
    --code-str: #a5e88a;
    --code-fn: #7dd3fc;
    --code-obj: #ffd580;
    --code-punc: #89a5a2;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    min-height: 30rem;
    padding: clamp(1.25rem, 2.2vw, 1.6rem);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-lg);
    background: var(--panel-surface);
    box-shadow: var(--panel-shadow);
    color: var(--panel-text);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
  }

  :root[data-theme="light"] .pillar {
    --panel-surface: linear-gradient(180deg, #ffffff 0%, #f4f9f7 100%);
    --panel-inner: #f4f9f7;
    --panel-canvas: #ffffff;
    --panel-bar: rgb(13 122 95 / 0.035);
    --panel-highlight: rgb(13 122 95 / 0.035);
    --panel-text: #0b1f1d;
    --panel-muted: #52666b;
    --panel-line: rgb(6 78 59 / 0.1);
    --panel-accent: #0d7a5f;
    --panel-accent-soft: rgb(13 122 95 / 0.08);
    --panel-glow: rgb(13 122 95 / 0.08);
    --panel-shadow: 0 12px 32px rgb(16 52 45 / 0.08), 0 1px 2px rgb(16 52 45 / 0.04);
    --panel-hover-shadow: 0 18px 42px rgb(16 52 45 / 0.12), 0 0 0 1px rgb(13 122 95 / 0.08);
    --code-kw: #7c3aed;
    --code-str: #0d7a5f;
    --code-fn: #075985;
    --code-obj: #9a5b00;
    --code-punc: #52666b;
  }

  .pillar::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--tilt-x) var(--tilt-y),
      var(--panel-glow),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .pillar:hover {
    border-color: color-mix(in srgb, var(--panel-accent) 45%, transparent);
    box-shadow: var(--panel-hover-shadow);
  }

  .pillar:hover::after {
    opacity: 1;
  }

  .pillar-top {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .pillar-index {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--panel-accent) 40%, transparent);
    border-radius: 9px;
    background: var(--panel-accent-soft);
    color: var(--panel-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .pillar-content h3 {
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    line-height: 1.2;
  }

  .pillar-content p {
    margin-top: 0.45rem;
    color: var(--panel-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .glass-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--panel-line);
    border-radius: 14px;
    background: var(--panel-inner);
    box-shadow: inset 0 1px 0 var(--panel-highlight);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.35rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--panel-line);
    background: var(--panel-bar);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .pillar .window-dots {
    display: flex;
    gap: 0.24rem;
    flex: none;
  }

  .pillar .window-dots i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--panel-text) 18%, transparent);
  }

  .pillar .window-dots i:first-child {
    background: var(--panel-accent);
  }

  .window-name {
    overflow: hidden;
    color: var(--panel-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .window-meta {
    margin-left: auto;
    color: var(--panel-muted);
    white-space: nowrap;
  }

  /* Card 01 — Photoshop artboard */
  .artwork-body,
  .code-body,
  .audit-body {
    display: flex;
    flex: 1;
    min-height: 0;
    padding: clamp(0.9rem, 2vw, 1.2rem);
  }

  .artwork-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 1.35rem;
    min-height: 0;
    padding: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    background: var(--panel-canvas);
  }

  .artwork-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ps-badge {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: 1px solid rgb(49 168 255 / 0.35);
    border-radius: 8px;
    background: #001e36;
    color: #31a8ff;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .artwork-file {
    color: var(--panel-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--panel-accent) 40%, transparent);
    border-radius: 12px;
    background: var(--panel-accent-soft);
    color: var(--panel-accent);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .brand-type strong,
  .brand-type span {
    display: block;
  }

  .brand-type strong {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .brand-type span {
    margin-top: 0.3rem;
    color: var(--panel-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .palette-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .palette-bar i {
    display: block;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--panel-text) 12%, transparent);
    border-radius: 8px;
    background: var(--swatch);
  }

  /* Card 02 — readable code block */
  .code-body {
    align-items: center;
  }

  .code-block {
    width: 100%;
    margin: 0;
    padding: clamp(0.95rem, 2vw, 1.25rem);
    overflow: hidden;
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    background: var(--panel-canvas);
    color: var(--panel-text);
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.35vw, 0.78rem);
    line-height: 1.9;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  .code-row {
    display: block;
    min-height: 1.5em;
  }

  .tok-kw { color: var(--code-kw); }
  .tok-str { color: var(--code-str); }
  .tok-fn { color: var(--code-fn); }
  .tok-obj { color: var(--code-obj); }
  .tok-punc { color: var(--code-punc); }

  /* Card 03 — three scannable audit results */
  .audit-body {
    align-items: center;
  }

  .audit-rows {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audit-rows li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    background: var(--panel-canvas);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .check {
    color: var(--panel-accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .audit-rows em {
    color: var(--panel-muted);
    font-style: normal;
  }

  .tool-pill {
    margin-top: auto;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: var(--panel-accent-soft);
    color: var(--panel-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.4;
    text-align: center;
  }

  .spotlight {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .spotlight-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .spotlight-card:hover {
    border-color: var(--color-accent-line);
    box-shadow: var(--shadow-card);
  }

  .spotlight-preview {
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: radial-gradient(circle at 50% 20%, var(--color-accent-soft), transparent 60%), var(--color-bg-deep);
    text-decoration: none;
  }

  .spotlight-preview > * {
    width: 100%;
    max-width: 26rem;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .spotlight-card:hover .spotlight-preview > * {
    transform: scale(1.05) translateY(-4px);
  }

  .spotlight-copy {
    padding: clamp(1.6rem, 4vw, 2.5rem);
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .work-index {
    color: var(--color-accent);
    font-weight: 700;
  }

  .spotlight-copy h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .spotlight-copy h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .spotlight-copy h3 a:hover {
    color: var(--color-link);
  }

  .work-description {
    margin-top: 0.8rem;
    color: var(--color-muted);
  }

  .problem-impact {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .problem-impact span:not(.flow-arrow) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--color-link);
  }

  .problem-impact p {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .flow-arrow {
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .work-tags {
    margin-top: 1.35rem;
  }

  .work-security {
    margin-top: 1.35rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-accent-soft);
    font-size: 0.85rem;
  }

  .work-security strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.12em;
    color: var(--color-link);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-link);
    text-decoration: none;
  }

  .text-link span {
    transition: transform 200ms ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .work-all {
    margin-top: 1.75rem;
  }

  .spotlight-next {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 15rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px dashed var(--color-accent-line);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
