---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { site } from '../../data/site.js';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const filters = ['all', 'design', 'web', 'security'];
const featured = projects.find((project) => project.id === 'invoice-generator') ?? projects[0];
const anatomy = featured
  ? [
      { label: 'What it does', value: featured.data.description },
      { label: 'Built with', value: featured.data.stack?.join(' · ') ?? 'Python · Tkinter' },
      { label: 'Security note', value: featured.data.securityNotes },
    ]
  : [];
---

<BaseLayout title="Projects" description="Selected projects by Niroj Pyakurel, including the Invoice Generator.">
  <div class="container page">
    <header class="projects-hero panel">
      <div class="hero-copy">
        <SectionHeading
          as="h1"
          eyebrow="Projects"
          title="Things I've built"
          index="01"
        >
          Each project includes a short security note — what was considered, in plain language.
        </SectionHeading>

        <ul class="hero-stats">
          <li>
            <strong>{String(projects.length).padStart(2, '0')}</strong>
            <span>Case studies</span>
          </li>
          <li>
            <strong>{String(site.security.tools.length).padStart(2, '0')}</strong>
            <span>Security tools</span>
          </li>
          <li>
            <strong>{String(filters.length - 1).padStart(2, '0')}</strong>
            <span>Topics</span>
          </li>
        </ul>
      </div>
      <div class="hero-mark" aria-hidden="true">{'< />'}</div>
    </header>

    <div class="toolbar panel" role="group" aria-label="Filter projects by tag">
      <span class="toolbar-label">Filter by</span>
      <div class="filter-bar" data-tag-filter=".project-card">
        {filters.map((filter) => (
          <button type="button" data-filter={filter} aria-pressed={filter === 'all'}>{filter}</button>
        ))}
      </div>
      <span class="toolbar-count">{projects.length} shown</span>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          date={project.data.date}
          href={`/projects/${project.id}/`}
          featured={project.id === 'invoice-generator'}
        >
          {project.id === 'invoice-generator' && <ProjectPreview slot="media" />}
        </ProjectCard>
      ))}
    </div>

    {anatomy.length > 0 && (
      <section class="block" aria-labelledby="anatomy-title">
        <SectionHeading eyebrow="Inside a case study" title="What you'll find here" id="anatomy-title" index="02" />
        <div class="anatomy-grid">
          {anatomy.map((item, index) => (
            <article class="anatomy-card panel">
              <span class="anatomy-index" aria-hidden="true">0{index + 1}</span>
              <h3>{item.label}</h3>
              <p>{item.value}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <p class="empty-note">
      <span class="status-dot" aria-hidden="true"></span>
      More projects are added as the work happens.
    </p>
  </div>
</BaseLayout>

<script>
  import { initTagFilters } from '../../scripts/filters.js';

  initTagFilters();
</script>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .projects-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 55%),
      var(--color-surface);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy h1 {
    max-width: 18ch;
  }

  .hero-mark {
    position: absolute;
    right: -0.05em;
    bottom: -0.3em;
    font-family: var(--font-mono);
    font-size: clamp(6rem, 16vw, 12rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
    color: var(--color-accent-soft);
    pointer-events: none;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-stats strong {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-link);
  }

  .hero-stats span {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .toolbar-label,
  .toolbar-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .toolbar-count {
    margin-left: auto;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-bar button {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition), background-color var(--transition);
  }

  .filter-bar button:hover,
  .filter-bar button[aria-pressed='true'] {
    border-color: var(--color-accent-line);
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .project-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .project-grid :global(.project-card.featured) {
    grid-column: 1 / -1;
  }

  .block {
    margin-top: var(--space-section);
  }

  .anatomy-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .anatomy-card {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .anatomy-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .anatomy-card h3 {
    margin-top: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }

  .anatomy-card p {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .empty-note {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  @media (min-width: 760px) {
    .project-grid,
    .anatomy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1050px) {
    .anatomy-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
