---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.js';
import { socials } from '../data/socials.js';
import { experience } from '../data/experience.js';

const groups = [...new Set(experience.map((item) => item.group))];

const glance = [
  { value: String(experience.length).padStart(2, '0'), label: 'Roles held' },
  { value: String(site.skills.length).padStart(2, '0'), label: 'Skill areas' },
  { value: String(site.certifications.length).padStart(2, '0'), label: 'Certifications' },
  { value: String(site.projects.length).padStart(2, '0'), label: 'Case studies' },
];
---

<BaseLayout title="Resume" description={`Resume of ${site.name} — design, web development and cybersecurity.`}>
  <div class="container page">
    <header class="resume-header panel">
      <div class="header-main">
        <div class="monogram" aria-hidden="true">NP</div>
        <div>
          <p class="eyebrow">Resume · {new Date().getFullYear()}</p>
          <h1>{site.name}</h1>
          <p class="tagline">Freelance designer · Computer Science student · {site.location}</p>
        </div>
      </div>
      <div class="header-actions">
        <a class="pdf-link" href="/niroj-pyakurel-resume.pdf?v=20261122" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
            <path d="M14 3v5h5" /><path d="M9 14h6" /><path d="m12 11 3 3-3 3" />
          </svg>
          View PDF resume
        </a>
        <a class="text-link" href="/contact/">Contact me →</a>
      </div>
    </header>

    <section class="summary panel" aria-label="Summary">
      <div class="summary-portrait">
        <picture>
          <source srcset="/niroj.webp?v=20261122c" type="image/webp" />
          <img src="/niroj.png?v=20261122b" width="128" height="128" loading="lazy" alt="Portrait of Niroj Pyakurel" />
        </picture>
        <span>Design · Web · Security</span>
      </div>
      <div class="summary-copy">
        <p class="eyebrow">Summary</p>
        <p>{site.about.lead} {site.about.closing}</p>
      </div>
    </section>

    <ul class="glance" aria-label="Resume at a glance">
      {glance.map((item) => (
        <li class="panel">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>

    <section class="block" aria-labelledby="strengths-title">
      <SectionHeading eyebrow="Strengths" title="What I bring" id="strengths-title" index="01" />
      <ul class="strength-grid">
        {site.services.map((service, index) => (
          <li class="panel strength-card">
            <span class="strength-index" aria-hidden="true">0{index + 1}</span>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="resume-contact-title">
      <SectionHeading eyebrow="Contact" title="Details" id="resume-contact-title" index="02" />
      <ul class="contact-list panel">
        {socials.map((social) => (
          <li>
            <span>{social.label}</span>
            <a href={social.href} rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{social.handle}</a>
          </li>
        ))}
        <li><span>Location</span><span>{site.location}</span></li>
      </ul>
    </section>

    <section class="block" aria-labelledby="resume-experience-title">
      <SectionHeading eyebrow="Experience" title="Where I've worked" id="resume-experience-title" index="03" />
      {groups.map((group) => (
        <div class="group">
          <h3>{group}</h3>
          <ol class="timeline">
            {experience.filter((item) => item.group === group).map((item) => (
              <li class="panel">
                <div class="timeline-head">
                  <div>
                    <strong>{item.role}</strong>
                    <span class="org">{item.organization}</span>
                  </div>
                  <span class="period">{item.period}</span>
                </div>
                {item.highlights.length > 0 && (
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="block" aria-labelledby="resume-projects-title">
      <SectionHeading eyebrow="Projects" title="Selected work" id="resume-projects-title" index="04" />
      <ul class="project-list">
        {site.projects.map((project) => (
          <li class="panel">
            <span class="project-mark" aria-hidden="true">↗</span>
            <div>
              <strong>{project.title}</strong>
              <p>{project.summary}</p>
              <ul class="chip-list">
                {project.highlights.slice(0, 3).map((highlight) => <li class="chip">{highlight}</li>)}
              </ul>
            </div>
            <a href={`/projects/${project.slug}/`}>Read case study →</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="resume-skills-title">
      <SectionHeading eyebrow="Skills" title="Toolkit" id="resume-skills-title" index="05" />
      <div class="skill-grid">
        {site.skills.map((group) => (
          <article class="skill-group panel">
            <h3>{group.label}</h3>
            <p>{group.items.join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="resume-education-title">
      <SectionHeading eyebrow="Education" title="Study & certifications" id="resume-education-title" index="06" />
      <div class="detail-grid">
        <div class="detail-panel panel">
          <h3>Education</h3>
          <ul class="details">
            {site.education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span>{item.school}</span>
                <span class="muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="detail-panel panel">
          <h3>Certifications</h3>
          <ul class="details">
            {site.certifications.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.issuer}</span>
                <span class="muted">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .resume-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 50%),
      var(--color-surface);
  }

  .header-main {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    border: 2px solid var(--color-accent);
    border-radius: 14px;
    background: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.08em;
  }

  .resume-header h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .tagline {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pdf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .pdf-link svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pdf-link:hover {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .text-link {
    font-size: 0.85rem;
    text-decoration: none;
  }

  .summary {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    margin-top: 1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background:
      radial-gradient(circle at 95% 10%, var(--color-accent-soft), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .summary-portrait {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }

  .summary-portrait picture {
    display: contents;
  }

  .summary-portrait img {
    width: clamp(5rem, 12vw, 7.5rem);
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 0.5rem var(--color-accent-soft);
  }

  .summary-portrait span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    text-align: center;
    white-space: nowrap;
  }

  .summary-copy p:last-child {
    max-width: 78ch;
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .glance {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .glance li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .glance strong {
    font-family: var(--font-mono);
    font-size: 1.7rem;
    line-height: 1;
    color: var(--color-link);
  }

  .glance span {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .strength-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .strength-card {
    padding: 1.6rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition), border-color var(--transition);
  }

  .strength-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-line);
  }

  .strength-index {
    display: block;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .strength-card h2 {
    font-size: 1.1rem;
  }

  .strength-card p {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .block {
    margin-top: var(--space-section);
  }

  .contact-list,
  .details,
  .timeline {
    padding: 0;
    list-style: none;
  }

  .contact-list {
    margin-top: 1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .contact-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.85rem 0;
  }

  .contact-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .contact-list span:first-child {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .group + .group {
    margin-top: 2.5rem;
  }

  .group > h3 {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  .timeline > li {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .timeline-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .timeline-head strong {
    display: block;
    font-size: 1.1rem;
  }

  .org {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-link);
  }

  .timeline ul {
    margin-top: 1rem;
    padding-left: 1.15rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .timeline ul li + li {
    margin-top: 0.4rem;
  }

  .project-list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  .project-list li {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .project-mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .project-list li > div {
    min-width: 0;
  }

  .project-list strong {
    font-size: 1.1rem;
  }

  .project-list p {
    max-width: 70ch;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .project-list .chip-list {
    margin-top: 1rem;
  }

  .project-list .chip {
    max-width: 100%;
    white-space: normal;
  }

  .project-list a {
    margin-left: auto;
    flex: none;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .skill-grid,
  .detail-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .skill-group,
  .detail-panel {
    padding: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .skill-group h3,
  .detail-panel h3 {
    margin-bottom: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skill-group p {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1rem;
  }

  .details li + li {
    border-top: 1px solid var(--color-border);
  }

  .details span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    color: var(--color-link) !important;
  }

  @media (max-width: 560px) {
    .project-list li {
      flex-wrap: wrap;
    }

    .project-list a {
      margin-left: 3.85rem;
    }
  }

  @media (min-width: 720px) {
    .summary {
      grid-template-columns: 9rem 1fr;
    }

    .glance {
      grid-template-columns: repeat(4, 1fr);
    }

    .strength-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .skill-grid,
    .detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media print {
    .pdf-link,
    .text-link {
      display: none;
    }

    .resume-header,
    .summary,
    .glance li,
    .strength-card,
    .contact-list,
    .timeline > li,
    .project-list li,
    .skill-group,
    .detail-panel {
      box-shadow: none;
      break-inside: avoid;
    }
  }
</style>
