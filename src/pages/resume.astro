---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.js';
import { socials } from '../data/socials.js';
import { experience } from '../data/experience.js';

const groups = [...new Set(experience.map((item) => item.group))];
---

<BaseLayout title="Resume" description={`Resume of ${site.name} — design, web development and cybersecurity.`}>
  <div class="container page">
    <header class="resume-header">
      <div>
        <p class="eyebrow">Resume</p>
        <h1>{site.name}</h1>
        <p class="tagline">Freelance designer · Computer Science student · {site.location}</p>
      </div>
      <a class="pdf-link" href="/niroj-pyakurel-resume.pdf" target="_blank" rel="noopener noreferrer">
        View PDF resume ↗
      </a>
    </header>

    <section class="block" aria-labelledby="resume-contact-title">
      <SectionHeading eyebrow="Contact" title="Details" id="resume-contact-title" />
      <ul class="contact-list">
        {socials.map((social) => (
          <li>
            <span>{social.label}</span>
            <a href={social.href} rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{social.handle}</a>
          </li>
        ))}
        <li><span>Location</span><span>{site.location}</span></li>
      </ul>
    </section>

    <section class="block" aria-labelledby="resume-experience-title">
      <SectionHeading eyebrow="Experience" title="Where I've worked" id="resume-experience-title" />
      {groups.map((group) => (
        <div class="group">
          <h3>{group}</h3>
          <ul class="timeline">
            {experience.filter((item) => item.group === group).map((item) => (
              <li>
                <div class="timeline-head">
                  <strong>{item.role} · {item.organization}</strong>
                  <span>{item.period}</span>
                </div>
                {item.highlights.length > 0 && (
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="block" aria-labelledby="resume-projects-title">
      <SectionHeading eyebrow="Projects" title="Selected work" id="resume-projects-title" />
      <ul class="details">
        {site.projects.map((project) => (
          <li>
            <strong>{project.title}</strong>
            <span>{project.summary}</span>
            <a href={`/projects/${project.slug}/`}>Read case study →</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="resume-skills-title">
      <SectionHeading eyebrow="Skills" title="Toolkit" id="resume-skills-title" />
      <div class="skill-grid">
        {site.skills.map((group) => (
          <div>
            <h3>{group.label}</h3>
            <p>{group.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="resume-education-title">
      <SectionHeading eyebrow="Education" title="Study & certifications" id="resume-education-title" />
      <div class="detail-grid">
        <div>
          <h3>Education</h3>
          <ul class="details">
            {site.education.map((item) => (
              <li>
                <strong>{item.degree}</strong>
                <span>{item.school}</span>
                <span class="muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Certifications</h3>
          <ul class="details">
            {site.certifications.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.issuer}</span>
                <span class="muted">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .resume-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .resume-header h1 {
    margin-top: 0.75rem;
  }

  .tagline {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .pdf-link {
    display: inline-flex;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .pdf-link:hover {
    border-color: var(--color-link);
  }

  .block {
    margin-top: var(--space-section);
  }

  .contact-list,
  .details,
  .timeline {
    padding: 0;
    list-style: none;
  }

  .contact-list {
    margin-top: 1.5rem;
  }

  .contact-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-list span:first-child {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .group + .group {
    margin-top: 2rem;
  }

  .group h3 {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .timeline-head span,
  .muted {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .timeline ul {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .timeline ul li {
    padding: 0;
    border: 0;
  }

  .timeline ul li + li {
    margin-top: 0.35rem;
  }

  .details {
    margin-top: 1.5rem;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .details span {
    color: var(--color-muted);
  }

  .details a {
    font-size: 0.85rem;
  }

  .skill-grid,
  .detail-grid {
    display: grid;
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .skill-grid > div,
  .detail-grid > div {
    padding: 1.25rem;
    background: var(--color-bg);
  }

  .skill-grid h3,
  .detail-grid h3 {
    margin-bottom: 0.75rem;
  }

  .skill-grid p {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  @media (min-width: 720px) {
    .skill-grid,
    .detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
