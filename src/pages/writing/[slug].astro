---
import { getCollection } from 'astro:content';

// Legacy route: keep old /writing/[slug] links working after the Blog rename.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { slug: post.id },
  }));
}

const { slug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/blog/${slug}/`} />
    <link rel="canonical" href={`/blog/${slug}/`} />
    <meta name="robots" content="noindex" />
    <title>Redirecting to Blog</title>
  </head>
  <body>
    <p><a href={`/blog/${slug}/`}>Continue to the blog →</a></p>
  </body>
</html>
