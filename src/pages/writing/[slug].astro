---
import { getCollection, render } from 'astro:content';

import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('writing');
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const notes = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const index = notes.findIndex((note) => note.id === entry.id);
const prev = index > 0
  ? { title: notes[index - 1].data.title, href: `/writing/${notes[index - 1].id}/` }
  : undefined;
const next = index < notes.length - 1
  ? { title: notes[index + 1].data.title, href: `/writing/${notes[index + 1].id}/` }
  : undefined;

const words = entry.body?.trim().split(/\s+/).length ?? 0;
const readingTime = `${Math.max(1, Math.ceil(words / 200))} min read`;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow="Note"
  date={entry.data.date}
  tags={entry.data.tags}
  readingTime={readingTime}
  backHref="/writing/"
  backLabel="All notes"
  prev={prev}
  next={next}
>
  <Content />
</ArticleLayout>
