---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const filters = ['all', 'design', 'web', 'security'];
---

<BaseLayout title="Writing" description="Occasional notes on design, web work and practical security tooling.">
  <div class="container page">
    <SectionHeading as="h1" eyebrow="Writing" title="Notes">
      Occasional notes only — no schedule, just things worth writing down.
    </SectionHeading>

    <div class="filter-bar" data-tag-filter=".note-card" role="group" aria-label="Filter notes by tag">
      {filters.map((filter) => (
        <button type="button" data-filter={filter} aria-pressed={filter === 'all'}>{filter}</button>
      ))}
    </div>

    <div class="note-list">
      {notes.map((note) => (
        <NoteCard
          title={note.data.title}
          description={note.data.description}
          tags={note.data.tags}
          date={note.data.date}
          href={`/writing/${note.id}/`}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { initTagFilters } from '../../scripts/filters.js';

  initTagFilters();
</script>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .filter-bar button {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .filter-bar button:hover,
  .filter-bar button[aria-pressed='true'] {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .note-list {
    margin-top: 1rem;
  }
</style>
