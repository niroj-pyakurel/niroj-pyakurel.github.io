---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NoteCard from '../../components/NoteCard.astro';
import { site } from '../../data/site.js';

const notes = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const filters = ['all', 'design', 'web', 'security'];
const latest = notes[0];
---

<BaseLayout title="Writing" description="Occasional notes on design, web work and practical security tooling.">
  <div class="container page">
    <header class="writing-hero panel">
      <div class="hero-copy">
        <SectionHeading as="h1" eyebrow="Writing" title="Notes" index="02">
          Occasional notes only — no schedule, just things worth writing down.
        </SectionHeading>

        <a class="latest-link" href={`/writing/${latest.id}/`}>
          <span class="latest-label">Latest note</span>
          <strong>{latest.data.title}</strong>
          <span class="latest-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-mark" aria-hidden="true">{'✎'}</div>
    </header>

    <div class="toolbar panel" role="group" aria-label="Filter notes by tag">
      <span class="toolbar-label">Filter by</span>
      <div class="filter-bar" data-tag-filter=".note-card">
        {filters.map((filter) => (
          <button type="button" data-filter={filter} aria-pressed={filter === 'all'}>{filter}</button>
        ))}
      </div>
      <span class="toolbar-count">{notes.length} shown</span>
    </div>

    <div class="writing-layout">
      <div class="note-list">
        {notes.map((note) => (
          <NoteCard
            title={note.data.title}
            description={note.data.description}
            tags={note.data.tags}
            date={note.data.date}
            href={`/writing/${note.id}/`}
          />
        ))}
      </div>

      <aside class="writing-aside">
        <section class="aside-panel panel">
          <p class="eyebrow">In these notes</p>
          <h2>Topics</h2>
          <ul class="chip-list">
            {filters.slice(1).map((filter) => (
              <li class:list={['chip', { 'chip-accent': filter === 'security' }]}>{filter}</li>
            ))}
          </ul>
          <p>{site.security.note}</p>
        </section>

        <section class="aside-panel panel subscribe">
          <span class="subscribe-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" />
            </svg>
          </span>
          <h2>Get the notes</h2>
          <p>Add the feed to your reader — new notes appear there automatically.</p>
          <a href="/rss.xml">Subscribe via RSS →</a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { initTagFilters } from '../../scripts/filters.js';

  initTagFilters();
</script>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .writing-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 55%),
      var(--color-surface);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy h1 {
    max-width: 18ch;
  }

  .hero-mark {
    position: absolute;
    right: 0.1em;
    bottom: -0.25em;
    font-size: clamp(6rem, 16vw, 11rem);
    line-height: 1;
    color: var(--color-accent-soft);
    pointer-events: none;
  }

  .latest-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 42rem;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    text-decoration: none;
    transition: transform var(--transition), border-color var(--transition);
  }

  .latest-link:hover {
    transform: translateX(3px);
    border-color: var(--color-accent);
  }

  .latest-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .latest-link strong {
    font-size: 1rem;
  }

  .latest-arrow {
    margin-left: auto;
    color: var(--color-link);
  }

  .toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .toolbar-label,
  .toolbar-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .toolbar-count {
    margin-left: auto;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-bar button {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition), background-color var(--transition);
  }

  .filter-bar button:hover,
  .filter-bar button[aria-pressed='true'] {
    border-color: var(--color-accent-line);
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .writing-layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .note-list {
    min-width: 0;
  }

  .writing-aside {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .aside-panel {
    padding: 1.75rem;
    background: var(--color-surface);
    box-shadow: none;
  }

  .aside-panel h2 {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 1.35rem;
  }

  .aside-panel > p:not(.eyebrow) {
    margin-top: 1.25rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .subscribe {
    background:
      radial-gradient(circle at 100% 0%, var(--color-accent-soft), transparent 55%),
      var(--color-surface);
  }

  .subscribe-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--color-accent-line);
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-link);
  }

  .subscribe-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .aside-panel a {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .writing-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 3rem;
    }
  }
</style>
